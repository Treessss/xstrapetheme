{{ 'xstrape-home.css' | asset_url | stylesheet_tag }}

<section
  class="xstrape-home-scope xh-section"
  style="--xh-page-bg: {{ section.settings.page_background | default: '#ffffff' }}; --xh-text: {{ section.settings.text_color | default: '#111111' }}; --xh-muted: {{ section.settings.muted_text_color | default: '#6c6c6c' }};"
>
  <div class="xh-container">
    <div class="xh-promo-grid">
      {% for block in section.blocks %}
        <a class="xh-media-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <span class="xh-media-card__image">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 100vw, 50vw', widths: '600,900,1200,1500,1800'
              }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'xh-media-card__placeholder' }}
            {% endif %}
          </span>
          <span class="xh-media-card__body">
            {% if block.settings.kicker != blank %}
              <span class="xh-eyebrow" style="color: rgb(255 255 255 / 0.78);">{{ block.settings.kicker | escape }}</span>
            {% endif %}
            {% if block.settings.title != blank %}
              <span class="xh-media-card__title">{{ block.settings.title | escape }}</span>
            {% endif %}
            {% if block.settings.text != blank %}
              <span class="xh-media-card__text">{{ block.settings.text | escape }}</span>
            {% endif %}
            {% if block.settings.button_text != blank %}
              <span class="xh-pill-button" style="margin-top: 1.15rem;">{{ block.settings.button_text | escape }}</span>
            {% endif %}
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Xstrape promo grid",
  "class": "shopify-section--xstrape-promo-grid",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "page_background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#6c6c6c" }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo card",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "text", "id": "title", "label": "Title", "default": "Promo title" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop now" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Xstrape promo grid" }
  ]
}
{% endschema %}
