{{ 'xstrape-home.css' | asset_url | stylesheet_tag }}

<section
  class="xstrape-home-scope xh-hero{% if section.settings.hero_overlay_opacity == 0 %} xh-hero--no-overlay{% endif %}"
  style="--xh-hero-text: {{ section.settings.hero_text_color | default: '#ffffff' }}; --xh-hero-overlay-opacity: {{ section.settings.hero_overlay_opacity | divided_by: 100.0 }};"
>
  <div class="xh-hero__media">
    {% if section.settings.hero_image != blank %}
      <picture>
        {% if section.settings.hero_mobile_image != blank %}
          <source
            media="(max-width: 699px)"
            srcset="{{ section.settings.hero_mobile_image | image_url: width: 700 }} 700w, {{ section.settings.hero_mobile_image | image_url: width: 1000 }} 1000w, {{ section.settings.hero_mobile_image | image_url: width: 1400 }} 1400w"
          >
        {% endif %}
        {{
          section.settings.hero_image
          | image_url: width: 2600
          | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '700,1000,1400,1800,2200,2600'
        }}
      </picture>
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'xh-hero__placeholder' }}
    {% endif %}
  </div>

  <div class="xh-hero__content">
    {% if section.settings.hero_kicker != blank %}
      <p class="xh-eyebrow">{{ section.settings.hero_kicker | escape }}</p>
    {% endif %}
    {% if section.settings.hero_heading != blank %}
      <h1 class="xh-heading">{{ section.settings.hero_heading | escape }}</h1>
    {% endif %}
    {% if section.settings.hero_subheading != blank %}
      <p class="xh-subheading">{{ section.settings.hero_subheading | escape }}</p>
    {% endif %}
    {% if section.settings.hero_button_text != blank and section.settings.hero_button_link != blank %}
      <div class="xh-hero__actions">
        <a class="xh-pill-button" href="{{ section.settings.hero_button_link }}">{{ section.settings.hero_button_text | escape }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "首页主视觉",
  "class": "shopify-section--xstrape-hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "桌面图片"
    },
    {
      "type": "image_picker",
      "id": "hero_mobile_image",
      "label": "移动端图片"
    },
    {
      "type": "text",
      "id": "hero_kicker",
      "label": "小标题",
      "default": "Built for Starlink"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "标题",
      "default": "Gear That Goes The Distance"
    },
    {
      "type": "text",
      "id": "hero_subheading",
      "label": "副标题",
      "default": "Power, mount, and protect your Starlink Mini wherever the road takes you."
    },
    {
      "type": "text",
      "id": "hero_button_text",
      "label": "按钮文字",
      "default": "Shop Travel Gear"
    },
    {
      "type": "url",
      "id": "hero_button_link",
      "label": "按钮链接"
    },
    {
      "type": "color",
      "id": "hero_text_color",
      "label": "文字颜色",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "hero_overlay_opacity",
      "label": "遮罩透明度",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    }
  ],
  "presets": [
    {
      "name": "首页主视觉"
    }
  ]
}
{% endschema %}
