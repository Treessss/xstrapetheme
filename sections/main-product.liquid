</style>

{%- capture product_form_id -%}product-form-{{ product.id }}-{{ section.id }}{%- endcapture -%}

<div {% render 'section-properties', tight: true %}>
  <product-rerender id="product-info-{{ product.id }}-{{ section.id }}" observe-form="{{ product_form_id }}" allow-partial-rerender>
    <div class="product">
      <div class="product__main-grid">
        {%- if product.media.size > 0 -%}
          {%- render 'product-gallery', product: product, product_form_id: product_form_id -%}
        {%- endif -%}

        <div class="product-info-column">
          <div class="product-info-panel">
            {%- render 'product-info',
              product: product,
              update_url: true,
              product_form_id: product_form_id,
              context: 'main_product'
            -%}
          </div>

          {%- assign pm_over_view = product.metafields.custom.pm_over_view.value | default: product.metafields.custom.pm_over_view -%}
          <div class="product-info-panel product-info-panel--overview">
            <details class="product-info__overview-disclosure">
              <summary class="product-info__overview-summary">
                <span class="product-info__overview-caret" aria-hidden="true"></span>
                <span>Overview</span>
              </summary>

              <div class="product-info__overview-body">
                {%- if pm_over_view != blank -%}
                  <ul class="product-info__pm-overview-list" role="list">
                    {%- assign pm_over_view_lines = pm_over_view | newline_to_br | split: '<br />' -%}
                    {%- for line in pm_over_view_lines -%}
                      {%- assign cleaned = line | strip | remove_first: '•' | remove_first: '-' | strip -%}
                      {%- if cleaned != blank -%}
                        <li>{{ cleaned }}</li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- elsif product.description != blank -%}
                  <div class="prose">{{ product.description }}</div>
                {%- endif -%}
              </div>
            </details>
          </div>

          {%- liquid
            assign also_bought_products = product.metafields.custom.also_bought_products.value
            if also_bought_products == blank
              assign fallback_collection = product.collections | first
              assign also_bought_products = fallback_collection.products
            endif

            assign also_bought_count = 0
          -%}

          {%- capture also_bought_cards -%}
            {%- for recommended_product in also_bought_products -%}
              {%- if recommended_product.id == product.id -%}
                {%- continue -%}
              {%- endif -%}

              {%- assign recommended_variant = recommended_product.selected_or_first_available_variant -%}
              {%- assign recommended_subtitle = recommended_product.metafields.custom.card_subtitle.value | default: recommended_product.metafields.custom.subtitle.value | default: recommended_product.type -%}
              {%- assign also_bought_count = also_bought_count | plus: 1 -%}

              <div class="product-info__also-bought-card">
                <a href="{{ recommended_product.url }}" class="product-info__also-bought-image" aria-label="{{ recommended_product.title | escape }}">
                  {%- if recommended_product.featured_media != blank -%}
                    {{- recommended_product.featured_media | image_url: width: 260 | image_tag: loading: 'lazy', widths: '140,200,260', sizes: '96px', alt: recommended_product.title -}}
                  {%- endif -%}
                </a>

                <a href="{{ recommended_product.url }}" class="product-info__also-bought-text">
                  <p class="product-info__also-bought-name">{{ recommended_product.title }}</p>
                  {%- if recommended_subtitle != blank -%}
                    <p class="product-info__also-bought-subtitle">{{ recommended_subtitle }}</p>
                  {%- endif -%}
                  <p class="product-info__also-bought-price">
                    {%- if recommended_variant.compare_at_price != blank and recommended_variant.compare_at_price > recommended_variant.price -%}
                      <span class="product-info__also-bought-compare">{{ recommended_variant.compare_at_price | money_without_trailing_zeros }}</span>
                    {%- endif -%}
                    <span>{{ recommended_variant.price | money_without_trailing_zeros }}</span>
                  </p>
                </a>

                {%- form 'product', recommended_product, class: 'product-info__also-bought-form' -%}
                  <input type="hidden" name="id" value="{{ recommended_variant.id }}">
                  <button type="submit" class="product-info__also-bought-add" aria-label="Add {{ recommended_product.title | escape }} to cart">+</button>
                {%- endform -%}
              </div>

              {%- if also_bought_count == 2 -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}

          {%- if also_bought_count > 0 -%}
            <div class="product-info__also-bought">
              <h2 class="product-info__also-bought-title">Others Like You Also Bought:</h2>
              <div class="product-info__also-bought-grid">
                {{- also_bought_cards -}}
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="product-description-below">
        {%- comment -%}Anchor tabs: only show buttons for sections that have content{%- endcomment -%}
        {%- assign pm_pc_desc_banner = product.metafields.custom.pm_pc_desc_banner.value -%}
        {%- assign pm_mobile_desc_banner = product.metafields.custom.pm_mobile_desc_banner.value -%}
        {%- assign pm_desc_video_overview = product.metafields.custom.pm_desc_video_overview.value | default: product.metafields.custom.pm_desc_video_overview -%}
        {%- assign pm_desc_video_review = product.metafields.custom.pm_desc_video_review.value | default: product.metafields.custom.pm_desc_video_review -%}
        {%- assign pm_desc_video_installation = product.metafields.custom.pm_desc_video_installation.value | default: product.metafields.custom.pm_desc_video_installation -%}

        {%- assign pm_desc_1_image = product.metafields.custom.pm_desc_1_image.value -%}
        {%- assign pm_desc_1_title = product.metafields.custom.pm_desc_1_title.value | default: product.metafields.custom.pm_desc_1_title -%}
        {%- assign pm_desc_1_content = product.metafields.custom.pm_desc_1_content.value | default: product.metafields.custom.pm_desc_1_content -%}

        {%- assign pm_desc_2_image = product.metafields.custom.pm_desc_2_image.value -%}
        {%- assign pm_desc_2_title = product.metafields.custom.pm_desc_2_title.value | default: product.metafields.custom.pm_desc_2_title -%}
        {%- assign pm_desc_2_content = product.metafields.custom.pm_desc_2_content.value | default: product.metafields.custom.pm_desc_2_content -%}

        {%- assign pm_desc_3_image = product.metafields.custom.pm_desc_3_image.value -%}
        {%- assign pm_desc_3_title = product.metafields.custom.pm_desc_3_title.value | default: product.metafields.custom.pm_desc_3_title -%}
        {%- assign pm_desc_3_content = product.metafields.custom.pm_desc_3_content.value | default: product.metafields.custom.pm_desc_3_content -%}

        {%- assign pm_desc_4_image = product.metafields.custom.pm_desc_4_image.value -%}
        {%- assign pm_desc_4_title = product.metafields.custom.pm_desc_4_title.value | default: product.metafields.custom.pm_desc_4_title -%}
        {%- assign pm_desc_4_content = product.metafields.custom.pm_desc_4_content.value | default: product.metafields.custom.pm_desc_4_content -%}

        {%- assign pm_desc_5_image = product.metafields.custom.pm_desc_5_image.value -%}
        {%- assign pm_desc_5_title = product.metafields.custom.pm_desc_5_title.value | default: product.metafields.custom.pm_desc_5_title -%}
        {%- assign pm_desc_5_content = product.metafields.custom.pm_desc_5_content.value | default: product.metafields.custom.pm_desc_5_content -%}

        {%- assign pm_desc_6_image = product.metafields.custom.pm_desc_6_image.value -%}
        {%- assign pm_desc_6_title = product.metafields.custom.pm_desc_6_title.value | default: product.metafields.custom.pm_desc_6_title -%}
        {%- assign pm_desc_6_content = product.metafields.custom.pm_desc_6_content.value | default: product.metafields.custom.pm_desc_6_content -%}

        {%- assign pm_more_info = product.metafields.custom.pm_more_info.value | default: product.metafields.custom.pm_more_info -%}
        {%- assign pm_faq = product.metafields.custom.pm_faq.value | default: product.metafields.custom.pm_faq -%}

        {%- assign has_overviews = false -%}
        {%- if pm_pc_desc_banner != blank or pm_mobile_desc_banner != blank -%}{%- assign has_overviews = true -%}{%- endif -%}
        {%- if pm_desc_1_image != blank or pm_desc_1_title != blank or pm_desc_1_content != blank -%}{%- assign has_overviews = true -%}{%- endif -%}
        {%- if pm_desc_2_image != blank or pm_desc_2_title != blank or pm_desc_2_content != blank -%}{%- assign has_overviews = true -%}{%- endif -%}
        {%- if pm_desc_3_image != blank or pm_desc_3_title != blank or pm_desc_3_content != blank -%}{%- assign has_overviews = true -%}{%- endif -%}
        {%- if pm_desc_4_image != blank or pm_desc_4_title != blank or pm_desc_4_content != blank -%}{%- assign has_overviews = true -%}{%- endif -%}
        {%- if pm_desc_5_image != blank or pm_desc_5_title != blank or pm_desc_5_content != blank -%}{%- assign has_overviews = true -%}{%- endif -%}
        {%- if pm_desc_6_image != blank or pm_desc_6_title != blank or pm_desc_6_content != blank -%}{%- assign has_overviews = true -%}{%- endif -%}

        {%- assign has_videos = false -%}
        {%- if pm_desc_video_overview != blank or pm_desc_video_review != blank or pm_desc_video_installation != blank -%}{%- assign has_videos = true -%}{%- endif -%}

        {%- assign has_more_info = false -%}
        {%- if pm_more_info != blank -%}{%- assign has_more_info = true -%}{%- endif -%}

        {%- assign has_description = false -%}
        {%- if pm_more_info == blank and product.description != blank -%}{%- assign has_description = true -%}{%- endif -%}

        {%- assign has_faq = false -%}
        {%- if pm_faq != blank -%}{%- assign has_faq = true -%}{%- endif -%}
        {%- comment -%}
          Reviews (Loox) is rendered as a separate "product-app-blocks" section (see templates/product.json).
          We can't reliably detect it from within this section, so we always show the Reviews tab and resolve
          its scroll target in JS at click time.
        {%- endcomment -%}
        {%- assign has_reviews = true -%}

        {%- assign has_any_tabs = false -%}
        {%- if has_overviews or has_videos or has_more_info or has_description or has_faq or has_reviews -%}{%- assign has_any_tabs = true -%}{%- endif -%}

        {%- assign first_tab = '' -%}
        {%- if has_overviews -%}
          {%- assign first_tab = 'overviews' -%}
        {%- elsif has_videos -%}
          {%- assign first_tab = 'videos' -%}
        {%- elsif has_more_info -%}
          {%- assign first_tab = 'more_info' -%}
        {%- elsif has_description -%}
          {%- assign first_tab = 'description' -%}
        {%- elsif has_faq -%}
          {%- assign first_tab = 'faq' -%}
        {%- elsif has_reviews -%}
          {%- assign first_tab = 'reviews' -%}
        {%- endif -%}

        {%- if has_any_tabs -%}
          <div class="pm-anchor-tabs" data-anchor-tabs>
            <div class="pm-anchor-tabs__list" role="tablist" aria-label="Product section navigation">
              {%- if has_overviews -%}
                <button class="pm-anchor-tabs__btn" type="button" data-anchor="#pm-overviews-{{ section.id }}" aria-current="{% if first_tab == 'overviews' %}true{% else %}false{% endif %}">Overviews</button>
              {%- endif -%}
              {%- if has_videos -%}
                <button class="pm-anchor-tabs__btn" type="button" data-anchor="#pm-videos-anchor-{{ section.id }}" aria-current="{% if first_tab == 'videos' %}true{% else %}false{% endif %}">Video</button>
              {%- endif -%}
              {%- if has_more_info -%}
                <button class="pm-anchor-tabs__btn" type="button" data-anchor="#pm-more-info-anchor-{{ section.id }}" aria-current="{% if first_tab == 'more_info' %}true{% else %}false{% endif %}">More Info</button>
              {%- endif -%}
              {%- if has_description -%}
                <button class="pm-anchor-tabs__btn" type="button" data-anchor="#pm-description-anchor-{{ section.id }}" aria-current="{% if first_tab == 'description' %}true{% else %}false{% endif %}">Description</button>
              {%- endif -%}
              {%- if has_faq -%}
                <button class="pm-anchor-tabs__btn" type="button" data-anchor="#pm-faq-anchor-{{ section.id }}" aria-current="{% if first_tab == 'faq' %}true{% else %}false{% endif %}">FAQ</button>
              {%- endif -%}
              {%- if has_reviews -%}
                {%- assign reviews_count = product.metafields.reviews.rating_count.value | default: 0 | plus: 0 -%}
                <button class="pm-anchor-tabs__btn" type="button" data-anchor="#pm-reviews-anchor-{{ section.id }}" aria-current="{% if first_tab == 'reviews' %}true{% else %}false{% endif %}">
                  Reviews{%- if reviews_count > 0 -%} ({{ reviews_count }}){%- endif -%}
                </button>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <script>
          (() => {
            const root = document.querySelector('#shopify-section-{{ section.id }} [data-anchor-tabs]');
            if (!root) return;

            const buttons = Array.from(root.querySelectorAll('[data-anchor]'));
            if (buttons.length === 0) return;

            const REVIEWS_SEL = '#pm-reviews-anchor-{{ section.id }}';

            const setCurrent = (btn) => {
              buttons.forEach((b) => b.setAttribute('aria-current', String(b === btn)));
            };

            const resolveTarget = (sel) => {
              let el = sel ? document.querySelector(sel) : null;
              if (!el && sel === REVIEWS_SEL) {
                el = Array.from(document.querySelectorAll('.shopify-section--product-app-blocks .pm-app-blocks__title'))
                  .find((t) => (t.textContent || '').trim().toLowerCase() === 'reviews')
                  ?.closest('.shopify-section--product-app-blocks');
              }
              return el;
            };

            const buildPairs = () =>
              buttons
                .map((btn) => {
                  const sel = btn.getAttribute('data-anchor');
                  const el = resolveTarget(sel);
                  return el ? { btn, el } : null;
                })
                .filter(Boolean);

            /** Tab order can differ from DOM order — use vertical position on the page. */
            const sortPairsByPagePosition = (pairs) =>
              [...pairs].sort((a, b) => {
                const ya = a.el.getBoundingClientRect().top + window.scrollY;
                const yb = b.el.getBoundingClientRect().top + window.scrollY;
                return ya - yb;
              });

            /** Resolve theme sticky announcement + header offset for scrollspy line. */
            const readStickyOffsetPx = () => {
              const probe = document.createElement('div');
              probe.style.cssText =
                'position:absolute;left:0;width:1px;height:1px;margin:0;border:0;padding:0;visibility:hidden;pointer-events:none;top:0';
              probe.style.top = 'var(--sticky-area-height, 0px)';
              document.documentElement.appendChild(probe);
              const px = parseFloat(getComputedStyle(probe).top) || 0;
              probe.remove();
              return px;
            };

            let scrollLockUntil = 0;

            /**
             * Pick the tab that best matches what the user is viewing:
             * prefer the block with the largest overlap with the upper "reading zone" (below sticky chrome),
             * then fall back to classic anchor line (last section whose top crossed that line).
             */
            const syncActiveFromScroll = () => {
              if (Date.now() < scrollLockUntil) return;

              const pairs = buildPairs();
              if (pairs.length === 0) return;

              const sorted = sortPairsByPagePosition(pairs);
              const vh = window.innerHeight;
              const sticky = readStickyOffsetPx();
              const zoneTop = sticky;
              const zoneBottom = sticky + Math.min(vh * 0.48, Math.max(260, vh * 0.36));

              const scoreInZone = (r) => {
                if (r.height < 10) {
                  const mid = (r.top + r.bottom) / 2;
                  if (mid >= zoneTop && mid <= zoneBottom) return 1e6 + mid;
                  if (r.top < zoneBottom && r.bottom > zoneTop) return 5e5 + mid;
                  return -1;
                }
                const segTop = Math.max(r.top, zoneTop);
                const segBottom = Math.min(r.bottom, zoneBottom);
                return Math.max(0, segBottom - segTop);
              };

              let bestBtn = sorted[0].btn;
              let bestScore = -Infinity;

              for (const { btn, el } of sorted) {
                const sc = scoreInZone(el.getBoundingClientRect());
                if (sc > bestScore) {
                  bestScore = sc;
                  bestBtn = btn;
                }
              }

              if (!Number.isFinite(bestScore) || bestScore <= 0) {
                const line = sticky + Math.min(152, Math.max(80, vh * 0.19));
                bestBtn = sorted[0].btn;
                for (const { btn, el } of sorted) {
                  if (el.getBoundingClientRect().top <= line) bestBtn = btn;
                }
              }

              setCurrent(bestBtn);
            };

            let scrollRaf = 0;
            const scheduleSync = () => {
              cancelAnimationFrame(scrollRaf);
              scrollRaf = requestAnimationFrame(syncActiveFromScroll);
            };

            window.addEventListener('scroll', scheduleSync, { passive: true });
            window.addEventListener('resize', scheduleSync);

            if ('onscrollend' in window) {
              window.addEventListener(
                'scrollend',
                () => {
                  scrollLockUntil = 0;
                  syncActiveFromScroll();
                },
                { passive: true }
              );
            }

            if ('IntersectionObserver' in window) {
              const io = new IntersectionObserver(scheduleSync, {
                root: null,
                rootMargin: '-12% 0px -52% 0px',
                threshold: [0, 0.05, 0.12, 0.28, 0.45],
              });
              buildPairs().forEach(({ el }) => io.observe(el));
            }

            requestAnimationFrame(syncActiveFromScroll);

            buttons.forEach((btn) => {
              btn.addEventListener('click', () => {
                const sel = btn.getAttribute('data-anchor');
                const el = resolveTarget(sel);
                if (!el) return;

                setCurrent(btn);
                scrollLockUntil = Date.now() + 950;
                el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                window.setTimeout(() => {
                  scrollLockUntil = 0;
                  syncActiveFromScroll();
                }, 1000);
              });
            });
          })();
        </script>

