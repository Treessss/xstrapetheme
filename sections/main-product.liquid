{%- render 'section-spacing-collapsing' -%}

<style>
  #shopify-section-{{ section.id }} {
    --product-grid: auto / minmax(0, 1fr);
    --product-gallery-media-list-grid: auto / auto-flow {% if section.settings.mobile_carousel_control == 'free_scroll' %}{% if section.settings.mobile_media_size == 'expanded' %}84vw{% else %}73vw{% endif %}{% else %}100%{% endif %};
    --product-gallery-media-list-gap: {% if section.settings.mobile_media_size == 'expanded' %}var(--spacing-0-5){% else %}var(--grid-gutter){% endif %};
  }
   
    @media screen and (max-width: 1024px) {
 #shopify-section-{{ section.id }} .section {
      padding-block-end:24px
    }
    }

  /* Right-side info panel background (scoped to this product section) */
  #shopify-section-{{ section.id }} .product-info-panel {
    background: #fff;
    border-radius: var(--rounded-xs, 8px);
    padding: var(--container-gutter, 16px);
    border-radius: 24px;
background: #FFF;
box-shadow: 0 12px 16px 0 #6b6f7314;
  }

  /* PM OVER VIEW: lay out like product-info-panel */
  #shopify-section-{{ section.id }} .product-info-column {
    display: grid;
    align-content: start;
    gap: var(--container-gutter, 16px);
  }

  #shopify-section-{{ section.id }} .Overviews_banner {
    border-radius: 32px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .Overviews_banner img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* Overviews content items (left image + right text) */
  #shopify-section-{{ section.id }} .Overviews_content_item {
    margin-top: var(--container-gutter, 16px);
  border-radius: 32px;
background: #FFF;
box-shadow: 0 12px 16px 0 #6b6f7314;
padding:10px;
  }

  #shopify-section-{{ section.id }} .Overviews_content_item--lr {
    display: grid;
    gap: 20px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .Overviews_content_item--rl {
    display: grid;
    gap: 20px;
    align-items: center;
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .Overviews_content_item--lr {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .Overviews_content_item--rl {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .Overviews_content_item--rl .Overviews_content_item-text {
      order: 1;
    }

    #shopify-section-{{ section.id }} .Overviews_content_item--rl .Overviews_content_item-media {
      order: 2;
    }
  }

  #shopify-section-{{ section.id }} .Overviews_content_item-media {
    border-radius: 32px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .Overviews_content_item-media img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .Overviews_content_item-title {
    color: #191919;
    font-size: 3rem;
    font-style: normal;
    font-weight: 700;
     line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .Overviews_content_item-content {
    margin-top: 20px;
   color: #666666;
 font-size: 1.3rem;
 font-style: normal;
 font-weight: 400;
 line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .Overviews_content_item-text {
    padding-inline: 16px;
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .Overviews_content_item-text {
      padding-inline: 24px;
    }
  }

  #shopify-section-{{ section.id }} .product-info__pm-overview-list {
    margin-top: 10px;
    padding-left: 1.1em;
    list-style: disc;
  }

  #shopify-section-{{ section.id }} .product-info__pm-overview-list > li + li {
    margin-top: 6px;
  }

  #shopify-section-{{ section.id }} .product-pm-overview__title {
    font-size: 28px;
    line-height: 1.2;
    font-weight: 700;
    margin-bottom:20px;
  }

  /* Right column recommended products panel (app mounts into slot) */
  #shopify-section-{{ section.id }} .pm-side-reco__content {
    margin-top: 12px;
  }

  /* Description below (align under right column on desktop) */
  #shopify-section-{{ section.id }} .product-description-below {
    margin-top: var(--spacing-8, 32px);
    border-radius: var(--rounded-xs, 8px);
 
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .product-description-below {
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .product-info-panel {
      padding: calc(var(--container-gutter, 16px) * 1.25);
    }
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} {
      --section-spacing-block-start: {% if section.settings.mobile_media_size == 'expanded' %}0px{% else %}var(--container-gutter){% endif %};
    }

    /* Mobile: always stack image on top, text below */
    #shopify-section-{{ section.id }} .Overviews_content_item--lr,
    #shopify-section-{{ section.id }} .Overviews_content_item--rl {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .Overviews_content_item--rl .Overviews_content_item-media {
      order: 1;
    }

    #shopify-section-{{ section.id }} .Overviews_content_item--rl .Overviews_content_item-text {
      order: 2;
    }

    #shopify-section-{{ section.id }} .Overviews_banner {
      border-radius: 24px;
    }

    #shopify-section-{{ section.id }} .Overviews_content_item {
      margin-top: 24px;
      padding: 12px;
      border-radius: 24px;
    }

    #shopify-section-{{ section.id }} .Overviews_content_item-media {
      border-radius: 24px;
    }

    #shopify-section-{{ section.id }} .Overviews_content_item-text {
      padding-inline: 12px;
    }

    #shopify-section-{{ section.id }} .Overviews_content_item-title {
      font-size: 1.5rem;
      line-height: 1.15;
      word-break: break-word;
    }

    #shopify-section-{{ section.id }} .Overviews_content_item-content {
      margin-top: 14px;
      font-size: 1rem;
      line-height: 1.55;
      word-break: break-word;
    }

    #shopify-section-{{ section.id }} .product-pm-overview__title {
      font-size: 22px;
      margin-bottom: 12px;
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- assign media_ratio = section.settings.desktop_media_width | divided_by: 50.0 -%}
      --product-grid: auto / minmax(0, {{ media_ratio }}fr) minmax(0, {{ 2.0 | minus: media_ratio }}fr);
      --product-gallery-media-list-grid: {% if section.settings.desktop_media_layout contains 'grid' %}auto-flow dense / repeat({% if section.settings.desktop_media_layout == 'grid_one' %}1{% else %}2{% endif %}, minmax(0, 1fr)){% else %}auto / auto-flow 100%{% endif %};
      --product-gallery-media-list-gap: calc(var(--grid-gutter) / 2);
    }

    {%- if section.settings.desktop_media_layout == 'grid_highlight' -%}
      #shopify-section-{{ section.id }} .product-gallery__media-list > :not([hidden]) {
        grid-column: span 2;
      }

      #shopify-section-{{ section.id }} .product-gallery__media-list > :not([hidden]) ~ *:not(.product-gallery__media--expand) {
        grid-column: span 1;
      }
    {%- endif -%}
  }

  @media screen and (min-width: 1400px) {
    #shopify-section-{{ section.id }} {
      --product-gallery-media-list-gap: var(--grid-gutter);
    }
  }

  /* Product videos tabs */
  #shopify-section-{{ section.id }} .fivestopsproduct_ProductVideos {
    margin-top: 32px;
  }

  #shopify-section-{{ section.id }} .pm-videos {
    display: grid;
    gap: 30px;
  }

  #shopify-section-{{ section.id }} .pm-videos__title {
    text-align: center;
    font-size: 40px;
    line-height: 1.1;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .pm-videos__tabs {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .pm-videos__tab {
    border: 1px solid rgb(0 0 0 / 10%);
    background: transparent;
    padding: 8px 14px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .pm-videos__tab[aria-selected="true"] {
    background: #111;
    color: #fff;
    border-color: #111;
  }

  #shopify-section-{{ section.id }} .pm-videos__panel {
    border-radius: 32px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 12px 16px 0 #6b6f7314;
  }

  #shopify-section-{{ section.id }} .pm-videos__panel iframe,
  #shopify-section-{{ section.id }} .pm-videos__panel video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
  }

  /* More info (JSON -> tables) */
  #shopify-section-{{ section.id }} .pm-more-info {
    margin-top: 52px;
    border-radius: 32px;
    background: #fff;
    box-shadow: 0 12px 16px 0 #6b6f7314;
    padding: 24px;
  }

  #shopify-section-{{ section.id }} .pm-more-info__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .pm-more-info__title {
    font-size: 32px;
    line-height: 1.1;
    font-weight: 700;
  }
  #shopify-section-{{ section.id }}  .prose {
    margin-top:16px
  }

  #shopify-section-{{ section.id }} .pm-more-info__toggle {
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: #fff;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    /* Default (expanded): show X by rotating the + */
    transform: rotate(45deg);
    transition: transform 0.5s ease;
  }

  #shopify-section-{{ section.id }} .pm-more-info.is-collapsed .pm-more-info__toggle {
    /* Collapsed: show + */
    transform: rotate(0deg);
  }

  #shopify-section-{{ section.id }} .pm-more-info__toggle::before,
  #shopify-section-{{ section.id }} .pm-more-info__toggle::after {
    content: "";
    position: absolute;
    width: 14px;
    height: 2px;
    background: #111;
    border-radius: 2px;
  }

  #shopify-section-{{ section.id }} .pm-more-info__toggle::after {
    transform: rotate(90deg);
  }

  #shopify-section-{{ section.id }} .pm-more-info__toggle {
    position: relative;
  }

  #shopify-section-{{ section.id }} .pm-more-info__content-wrap {
    overflow: hidden;
    max-height: 2000px; /* will be overridden inline by JS */
    transition: max-height 0.5s ease;
  }

  #shopify-section-{{ section.id }} .pm-more-info.is-collapsed .pm-more-info__content-wrap {
    max-height: 0 !important;
  }

  #shopify-section-{{ section.id }} .pm-more-info__grid {
    display: grid;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .pm-more-info__section-title {
    font-weight: 700;
    margin: 8px 0 10px;
  }

  #shopify-section-{{ section.id }} .pm-more-info__table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid #e6e6e6;
    background: #fff;
  }

  #shopify-section-{{ section.id }} .pm-more-info__table th,
  #shopify-section-{{ section.id }} .pm-more-info__table td {
    padding: 10px 12px;
    border-bottom: 1px solid #e6e6e6;
    border-right: 1px solid #e6e6e6;
    vertical-align: top;
    font-size: 14px;
    line-height: 1.35;
  }
@media (max-width: 699px) {
  .pm-product-description .prose iframe {
    display: block;
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 16 / 9 !important;
  }
}
  #shopify-section-{{ section.id }} .pm-more-info__table tr > :last-child {
    border-right: 0;
  }

  #shopify-section-{{ section.id }} .pm-more-info__table tr:last-child td,
  #shopify-section-{{ section.id }} .pm-more-info__table tr:last-child th {
    border-bottom: 0;
  }

  #shopify-section-{{ section.id }} .pm-more-info__table th {
    width: 38%;
    background: #f5f5f5;
    font-weight: 600;
  }

  /* Package includes table: 4 columns (List/Value/List/Value) */
  #shopify-section-{{ section.id }} .pm-more-info__table--pkg th {
    width: 18%;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .pm-more-info__table--pkg td {
    width: 32%;
  }

  /* Specification table: 4 columns (Label/Value/Label/Value) on desktop */
  #shopify-section-{{ section.id }} .pm-more-info__table--spec th {
    width: 18%;
   
  }

  #shopify-section-{{ section.id }} .pm-more-info__table--spec td {
    width: 32%;
  }

  /* FAQ (JSON -> accordion) */
  #shopify-section-{{ section.id }} .pm-faq {
    margin-top: 52px;
    border-radius: 32px;
    background: #fff;
    box-shadow: 0 12px 16px 0 #6b6f7314;
    padding: 24px;
  }

  #shopify-section-{{ section.id }} .pm-faq__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .pm-faq__title {
    font-size: 32px;
    line-height: 1.1;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .pm-faq__toggle {
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: #fff;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    position: relative;
    /* Default (expanded): show X by rotating the + */
    transform: rotate(45deg);
    transition: transform 0.5s ease;
  }

  #shopify-section-{{ section.id }} .pm-faq.is-collapsed .pm-faq__toggle {
    /* Collapsed: show + */
    transform: rotate(0deg);
  }

  #shopify-section-{{ section.id }} .pm-faq__toggle::before,
  #shopify-section-{{ section.id }} .pm-faq__toggle::after {
    content: "";
    position: absolute;
    width: 14px;
    height: 2px;
    background: #111;
    border-radius: 2px;
  }

  #shopify-section-{{ section.id }} .pm-faq__toggle::after {
    transform: rotate(90deg);
  }

  #shopify-section-{{ section.id }} .pm-faq__list {
    overflow: hidden;
  }

  

  #shopify-section-{{ section.id }} .pm-faq__content-wrap {
    overflow: hidden;
    max-height: 2000px; /* overridden inline by JS */
    transition: max-height 0.5s ease;
  }

  #shopify-section-{{ section.id }} .pm-faq.is-collapsed .pm-faq__content-wrap {
    max-height: 0 !important;
  }

  #shopify-section-{{ section.id }} .pm-faq__a-wrap {
    padding: 14px 16px;
  }

  #shopify-section-{{ section.id }} .pm-faq__a {
    color: #666666;
    font-size: 14px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .pm-faq__q-text {
    font-weight: 600;
    font-size: 14px;
    line-height: 1.35;
    margin-bottom: 6px;
    color: #111;
  }

  /* Anchor tabs (Overviews / More Info / FAQ / Reviews) */
  #shopify-section-{{ section.id }} .pm-anchor-tabs {
    margin: 0 auto 18px;
    width: fit-content;
    padding: 10px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 12px 16px 0 #6b6f7314;
    border: 1px solid #e6e6e6;
  }

  #shopify-section-{{ section.id }} .pm-anchor-tabs__list {
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .pm-anchor-tabs__btn {
    border: 0;
    background: transparent;
    padding: 10px 18px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 14px;
    line-height: 1;
    color: #111;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .pm-anchor-tabs__btn[aria-current="true"] {
    background: #111;
    color: #fff;
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .pm-anchor-tabs {
      padding: 8px;
        width: 100%;
      max-width: 100%;
     background: transparent;
    border: none;
    box-shadow: none;
    }
       #shopify-section-{{ section.id }} .pm-anchor-tabs__list {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; /* Firefox */
    }
    #shopify-section-{{ section.id }} .pm-anchor-tabs__list::-webkit-scrollbar {
      display: none; /* WebKit */
    }

    #shopify-section-{{ section.id }} .pm-anchor-tabs__btn {
      padding: 10px 14px;
      font-size: 14px;
        flex: 0 0 auto;
      white-space: nowrap;
    }
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .pm-more-info,
    #shopify-section-{{ section.id }} .pm-faq {
      margin-top: 24px;
    }

    #shopify-section-{{ section.id }} .pm-faq {
      border-radius: 24px;
      padding: 12px;
    }

    #shopify-section-{{ section.id }} .pm-faq__title {
      font-size: 22px;
    }
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .pm-more-info {
      border-radius: 24px;
      padding: 12px;
    }

    #shopify-section-{{ section.id }} .pm-more-info__title {
      font-size: 22px;
    }
  }

  @media screen and (max-width: 999px) {
    #shopify-section-{{ section.id }} .pm-videos__title {
      font-size: 24px;
    }

    #shopify-section-{{ section.id }} .pm-videos__panel {
      border-radius: 24px;
    }
  }

  #shopify-section-{{ section.id }} {
    background: #f3f3f3;
  }

  #shopify-section-{{ section.id }} .section {
    padding-block-start: 30px;
    padding-block-end: 56px;
  }

  #shopify-section-{{ section.id }} .product {
    width: min(1480px, calc(100vw - 40px));
    margin-inline: auto;
    display: block;
    column-gap: 0;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .product__main-grid {
    display: grid;
    grid: var(--product-grid);
    column-gap: 20px;
    row-gap: 20px;
    align-items: start;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .product-info-column {
    gap: 20px;
    min-width: 0;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .product-info-panel {
    width: 100%;
    max-width: 100%;
    border: 0;
    border-radius: 25px;
    background: #fff;
    box-shadow: none;
    padding: 30px 35px 15px;
  }

  #shopify-section-{{ section.id }} .pm-side-reco:has(.pm-side-reco__content:empty) {
    display: none;
  }

  #shopify-section-{{ section.id }} .product-info {
    --product-info-block-spacing: 0px;
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) max-content;
    column-gap: 18px;
    row-gap: 0;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .product-info > * + * {
    margin-block-start: 0 !important;
    margin-block-end: 0 !important;
  }

  #shopify-section-{{ section.id }} .product-info__block-item {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="title"] {
    grid-column: 1;
    grid-row: 2;
  }

  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="price"] {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
    align-self: start;
    padding-top: 5px;
  }

  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="badges"],
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="rating"],
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="sku"],
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="variant-picker"],
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="product-variations"],
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="line-item-property"],
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="inventory"],
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="buy-buttons"],
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="pickup-availability"],
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="text"],
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="liquid"],
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="custom-block"],
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="offer"] {
    grid-column: 1 / -1;
  }

  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="badges"],
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="rating"] {
    grid-row: 1;
    align-self: start;
    margin-top: 0 !important;
    margin-bottom: 8px !important;
    order: initial;
  }

  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="badges"] {
    display: none;
  }

  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="variant-picker"],
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="product-variations"],
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="line-item-property"],
  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="inventory"] {
    margin-top: 24px !important;
  }

  #shopify-section-{{ section.id }} .product-info__block-item[data-block-type="buy-buttons"] {
    margin-top: 16px !important;
