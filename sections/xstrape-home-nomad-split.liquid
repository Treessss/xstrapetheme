{{ 'xstrape-home.css' | asset_url | stylesheet_tag }}

<section
  class="xstrape-home-scope xh-nomad-split"
  style="--xh-page-bg: {{ section.settings.page_background | default: '#f3f3f3' }}; --xh-card-height: {{ section.settings.card_height }}px; --xh-card-height-mobile: {{ section.settings.card_height_mobile }}px;"
>
  <div class="xh-nomad-split__grid">
    {% for block in section.blocks %}
      <a
        class="xh-nomad-tile {% if block.settings.kicker == blank and block.settings.heading == blank and block.settings.button_text == blank %}xh-nomad-tile--image-only{% endif %}"
        {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
        style="--xh-tile-text: {{ block.settings.text_color | default: '#ffffff' }}; --xh-tile-overlay: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"
        {{ block.shopify_attributes }}
      >
        <span class="xh-nomad-tile__media">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1800
              | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 100vw, 50vw', widths: '600,900,1200,1500,1800'
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {% endif %}
        </span>
        {% if block.settings.kicker != blank or block.settings.heading != blank or block.settings.button_text != blank %}
          <span class="xh-nomad-tile__overlay"></span>
          <span class="xh-nomad-tile__content">
            {% if block.settings.kicker != blank %}
              <span class="xh-nomad-tile__kicker">{{ block.settings.kicker | escape }}</span>
            {% endif %}
            {% if block.settings.heading != blank %}
              <span class="xh-nomad-tile__heading">{{ block.settings.heading | escape }}</span>
            {% endif %}
            {% if block.settings.button_text != blank %}
              <span class="xh-nomad-tile__button">{{ block.settings.button_text | escape }}</span>
            {% endif %}
          </span>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Xstrape Nomad split",
  "class": "shopify-section--xstrape-nomad-split",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "card_height", "label": "Desktop card height", "min": 360, "max": 760, "step": 10, "default": 650 },
    { "type": "range", "id": "card_height_mobile", "label": "Mobile card height", "min": 180, "max": 420, "step": 10, "default": 250 },
    { "type": "color", "id": "page_background", "label": "Background", "default": "#f3f3f3" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "kicker", "label": "Small heading" },
        { "type": "text", "id": "heading", "label": "Large heading" },
        { "type": "text", "id": "button_text", "label": "Button text" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
        { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "default": 35 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Xstrape Nomad split",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
