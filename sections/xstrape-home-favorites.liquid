{{ 'xstrape-home.css' | asset_url | stylesheet_tag }}

<section
  class="xstrape-home-scope xh-section xh-favorites"
  style="--xh-page-bg: {{ section.settings.page_background | default: '#ffffff' }}; --xh-text: {{ section.settings.text_color | default: '#111111' }}; --xh-muted: {{ section.settings.muted_text_color | default: '#6c6c6c' }}; --xh-accent: {{ section.settings.accent_color | default: '#111111' }};"
>
  <div class="xh-container">
    <div class="xh-section-header">
      <div>
        {% if section.settings.products_kicker != blank %}
          <p class="xh-eyebrow">{{ section.settings.products_kicker | escape }}</p>
        {% endif %}
        {% if section.settings.products_title != blank %}
          <h2 class="xh-heading">{{ section.settings.products_title | escape }}</h2>
        {% endif %}
      </div>
      {% if section.settings.products_link_text != blank and section.settings.products_link_url != blank %}
        <a class="xh-pill-button" href="{{ section.settings.products_link_url }}">{{ section.settings.products_link_text | escape }}</a>
      {% endif %}
    </div>

    <div class="xh-product-list">
      {% assign favorite_blocks = section.blocks | where: 'type', 'favorite' %}
      {% assign featured_collection = section.settings.products_collection %}
      {% if favorite_blocks.size > 0 %}
        {% for block in favorite_blocks %}
          <a class="xh-favorite-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            <span class="xh-favorite-card__media">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 72vw, 25vw', widths: '360,540,720,900'
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </span>
            <span class="xh-favorite-card__body">
              {% if block.settings.title != blank %}
                <span class="xh-favorite-card__title">{{ block.settings.title | escape }}</span>
              {% endif %}
              {% if block.settings.text != blank %}
                <span class="xh-favorite-card__text">{{ block.settings.text | escape }}</span>
              {% endif %}
              {% if block.settings.price != blank %}
                <span class="xh-favorite-card__price">{{ block.settings.price | escape }}</span>
              {% endif %}
            </span>
          </a>
        {% endfor %}
      {% elsif featured_collection != blank and featured_collection.products_count > 0 %}
        {% for product in featured_collection.products limit: section.settings.products_count %}
          {% render 'product-card', product: product, show_quick_add: true, show_badges: true %}
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.products_count) %}
          {% capture placeholder_image %}product-{% cycle '1', '2', '3', '4', '5', '6' %}{% endcapture %}
          {% render 'product-card-placeholder', placeholder_image: placeholder_image, stacked: true %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Xstrape favorites",
  "class": "shopify-section--xstrape-favorites",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "products_kicker", "label": "Kicker" },
    { "type": "text", "id": "products_title", "label": "Heading", "default": "Gear You'll Love" },
    { "type": "collection", "id": "products_collection", "label": "Collection" },
    { "type": "range", "id": "products_count", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "products_link_text", "label": "View all text" },
    { "type": "url", "id": "products_link_url", "label": "View all link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "page_background", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#6c6c6c" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#111111" }
  ],
  "blocks": [
    {
      "type": "favorite",
      "name": "Favorite product",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Starlink Mini Accessory" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "price", "label": "Price" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Xstrape favorites" }
  ]
}
{% endschema %}
