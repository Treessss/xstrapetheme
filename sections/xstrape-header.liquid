{%- liquid
  assign is_home_overlay = false
  if section.settings.overlay_on_homepage and request.page_type == 'index'
    assign is_home_overlay = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --xstrape-header-max-width: {{ section.settings.max_width }}px;
    --xstrape-header-side-gap: {{ section.settings.side_gap }}px;
    --xstrape-header-top-gap: {{ section.settings.desktop_top_gap }}px;
    --xstrape-header-mobile-top-gap: {{ section.settings.mobile_top_gap }}px;
    --xstrape-header-height: {{ section.settings.desktop_height }}px;
    --xstrape-header-mobile-height: {{ section.settings.mobile_height }}px;
    --xstrape-header-radius: {{ section.settings.bar_radius }}px;
    --xstrape-header-panel-radius: {{ section.settings.mobile_panel_radius }}px;
    --xstrape-header-mobile-side-gap: {{ section.settings.mobile_side_gap | default: 10 }}px;
    --xstrape-header-mobile-bar-radius: {{ section.settings.mobile_bar_radius | default: 24 }}px;
    --xstrape-header-mobile-logo-left-padding: {{ section.settings.mobile_logo_left_padding | default: 25 }}px;
    --xstrape-header-mobile-logo-height-gap: {{ section.settings.mobile_logo_height_gap | default: 27 }}px;
    --xstrape-header-mobile-icon-width: {{ section.settings.mobile_icon_width | default: 45 }}px;
    --xstrape-header-mobile-menu-icon-width: {{ section.settings.mobile_menu_icon_width | default: 52 }}px;
    --xstrape-mobile-menu-top-spacing: {{ section.settings.mobile_menu_top_spacing | default: 5 }}px;
    --xstrape-mobile-menu-padding-x: {{ section.settings.mobile_menu_padding_x | default: 15 }}px;
    --xstrape-mobile-menu-padding-bottom: {{ section.settings.mobile_menu_padding_bottom | default: 15 }}px;
    --xstrape-mobile-menu-gap: {{ section.settings.mobile_menu_gap | default: 10 }}px;
    --xstrape-mobile-card-height: {{ section.settings.mobile_card_height | default: 82 }}px;
    --xstrape-mobile-card-padding: {{ section.settings.mobile_card_padding | default: 4 }}px;
    --xstrape-mobile-card-radius: {{ section.settings.mobile_card_radius | default: 16 }}px;
    --xstrape-mobile-card-image-size: {{ section.settings.mobile_card_image_size | default: 74 }}px;
    --xstrape-mobile-card-image-radius: {{ section.settings.mobile_card_image_radius | default: 11 }}px;
    --xstrape-mobile-card-content-gap: {{ section.settings.mobile_card_content_gap | default: 10 }}px;
    --xstrape-mobile-title-font-size: {{ section.settings.mobile_title_font_size | default: 16 }}px;
    --xstrape-mobile-subtitle-font-size: {{ section.settings.mobile_subtitle_font_size | default: 11 }}px;
    --xstrape-mobile-badge-font-size: {{ section.settings.mobile_badge_font_size | default: 11 }}px;
    --xstrape-mobile-arrow-size: {{ section.settings.mobile_arrow_size | default: 23 }}px;
    --xstrape-header-bg: {{ section.settings.bar_background }};
    --xstrape-header-text: {{ section.settings.text_color }};
    --xstrape-header-accent: {{ section.settings.accent_color }};
    --xstrape-header-panel-bg: {{ section.settings.panel_background }};
    --xstrape-header-card-bg: {{ section.settings.card_background }};
    --xstrape-header-shadow: 0 18px 38px rgb(0 0 0 / {{ section.settings.shadow_opacity | divided_by: 100.0 }});
    --xstrape-announcement-bg-rgb: {{ section.settings.announcement_background.rgb }};
    --xstrape-logo-y-offset: {{ section.settings.logo_vertical_offset | default: 0 }}px;
    --xstrape-logo-mobile-y-offset: {{ section.settings.logo_mobile_vertical_offset | default: 0 }}px;

    position: {% if is_home_overlay and section.settings.enable_sticky %}fixed{% elsif is_home_overlay %}absolute{% elsif section.settings.enable_sticky %}sticky{% else %}relative{% endif %};
    inset-inline: 0;
    top: calc(var(--sticky-announcement-bar-enabled, 0) * var(--announcement-bar-height, 0px));
    z-index: 80;
    background: transparent;
  }

  #shopify-section-{{ section.id }}::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    z-index: 0;
    height: 92px;
    background: linear-gradient(
      180deg,
      rgb(var(--xstrape-announcement-bg-rgb) / 0.72) 0%,
      rgb(var(--xstrape-announcement-bg-rgb) / 0.42) 44%,
      rgb(var(--xstrape-announcement-bg-rgb) / 0) 100%
    );
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .xstrape-header {
    position: relative;
    z-index: 1;
    color: var(--xstrape-header-text);
    padding: 0 0 var(--xstrape-header-top-gap);
  }

  #shopify-section-{{ section.id }} .xstrape-header__announcement {
    position: relative;
    z-index: 3;
    width: min(var(--xstrape-header-max-width), calc(100vw - (var(--xstrape-header-side-gap) * 2)));
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 8px;
    color: {{ section.settings.announcement_text_color }};
    font-size: 14px;
    font-weight: 850;
    line-height: 1;
    text-align: center;
    text-shadow: 0 1px 16px rgb(0 0 0 / 0.34);
  }

  #shopify-section-{{ section.id }} .xstrape-header__announcement-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 18px;
    padding: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .xstrape-header__announcement-cta {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .xstrape-header__announcement-info {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    margin-left: 4px;
    border: 2px solid currentColor;
    border-radius: 50%;
    color: inherit;
    font-size: 13px;
    font-weight: 900;
    line-height: 1;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .xstrape-header__bar {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(150px, auto) minmax(0, 1fr) minmax(160px, auto);
    align-items: center;
    gap: clamp(16px, 2vw, 34px);
    width: min(var(--xstrape-header-max-width), calc(100vw - (var(--xstrape-header-side-gap) * 2)));
    min-height: var(--xstrape-header-height);
    margin-inline: auto;
    padding-inline: clamp(28px, 3.2vw, 72px);
    border-radius: var(--xstrape-header-radius);
    background: var(--xstrape-header-bg);
    box-shadow: var(--xstrape-header-shadow), 0 2px 0 rgb(255 255 255 / 0.82) inset;
  }

  #shopify-section-{{ section.id }} .xstrape-header__logo-link {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    height: 100%;
    min-width: 0;
    color: inherit;
    line-height: 0;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .xstrape-header__logo {
    display: flex;
    align-items: center;
    height: var(--xstrape-header-height);
    margin: 0;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .xstrape-header__logo-image {
    display: block;
    width: auto;
    max-width: min({{ section.settings.logo_width }}px, 38vw);
    max-height: calc(var(--xstrape-header-height) - 24px);
    height: auto;
    flex: 0 0 auto;
    object-fit: contain;
    object-position: center;
    transform: translateY(var(--xstrape-logo-y-offset));
  }

  #shopify-section-{{ section.id }} .xstrape-header__logo-text {
    display: inline-flex;
    align-items: center;
    color: inherit;
    font-size: clamp(1.35rem, 2vw, 2.15rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translateY(var(--xstrape-logo-y-offset));
  }

  #shopify-section-{{ section.id }} .xstrape-header__nav {
    justify-self: center;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .xstrape-header__nav-list,
  #shopify-section-{{ section.id }} .xstrape-header__actions,
  #shopify-section-{{ section.id }} .xstrape-header__mobile-list,
  #shopify-section-{{ section.id }} .xstrape-header__mega-cards,
  #shopify-section-{{ section.id }} .xstrape-header__mega-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .xstrape-header__nav-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, {{ section.settings.nav_gap | divided_by: 10.0 }}vw, {{ section.settings.nav_gap }}px);
  }

  #shopify-section-{{ section.id }} .xstrape-header__nav-item {
    position: static;
  }

  #shopify-section-{{ section.id }} .xstrape-header__nav-summary,
  #shopify-section-{{ section.id }} .xstrape-header__nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--xstrape-header-text);
    font-size: {{ section.settings.nav_font_size }}px;
    font-weight: 850;
    letter-spacing: 0;
    line-height: 1.05;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .xstrape-header__nav-summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .xstrape-header__nav-item[open] .xstrape-header__nav-summary,
  #shopify-section-{{ section.id }} .xstrape-header__nav-summary:hover,
  #shopify-section-{{ section.id }} .xstrape-header__nav-link:hover,
  #shopify-section-{{ section.id }} .xstrape-header__nav-link--highlight {
    color: var(--xstrape-header-accent);
  }

  #shopify-section-{{ section.id }} .xstrape-header__mega-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    right: 0;
    z-index: 30;
    display: none;
    padding: 18px;
    border: 1px solid rgb(0 0 0 / 0.06);
    border-radius: 30px;
    background: var(--xstrape-header-panel-bg);
    color: #111;
    box-shadow: 0 24px 70px rgb(0 0 0 / 0.18);
  }

  #shopify-section-{{ section.id }} .xstrape-header__nav-item[open] .xstrape-header__mega-panel {
    display: block;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mega-inner {
    display: grid;
    grid-template-columns: minmax(330px, 0.9fr) minmax(0, 1.45fr) minmax(250px, 0.7fr);
    gap: 18px;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mega-cards,
  #shopify-section-{{ section.id }} .xstrape-header__mega-links {
    display: grid;
    gap: 10px;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mega-link-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mega-card {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    min-height: 92px;
    padding: 10px 12px 10px 10px;
    border-radius: 18px;
    background: var(--xstrape-header-card-bg);
    color: inherit;
    text-decoration: none;
    transition: transform 0.18s ease, background 0.18s ease;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mega-card:hover {
    transform: translateY(-1px);
    background: #ececec;
  }

  #shopify-section-{{ section.id }} .xstrape-header__thumb,
  #shopify-section-{{ section.id }} .xstrape-header__mobile-thumb {
    position: relative;
    display: block;
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 24%, rgb(255 255 255 / 0.95), rgb(255 255 255 / 0) 35%),
      linear-gradient(145deg, #fafafa, #d7d7d7 62%, #9a9a9a);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
  }

  #shopify-section-{{ section.id }} .xstrape-header__thumb {
    width: 76px;
    height: 76px;
    border-radius: 16px;
  }

  #shopify-section-{{ section.id }} .xstrape-header__thumb img,
  #shopify-section-{{ section.id }} .xstrape-header__mobile-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .xstrape-header__thumb--placeholder::before,
  #shopify-section-{{ section.id }} .xstrape-header__mobile-thumb--placeholder::before,
  #shopify-section-{{ section.id }} .xstrape-header__thumb--placeholder::after,
  #shopify-section-{{ section.id }} .xstrape-header__mobile-thumb--placeholder::after {
    content: "";
    position: absolute;
    border: 2px solid rgb(17 17 17 / 0.5);
  }

  #shopify-section-{{ section.id }} .xstrape-header__thumb--placeholder::before,
  #shopify-section-{{ section.id }} .xstrape-header__mobile-thumb--placeholder::before {
    width: 52%;
    height: 34%;
    left: 24%;
    top: 36%;
    border-radius: 8px;
  }

  #shopify-section-{{ section.id }} .xstrape-header__thumb--placeholder::after,
  #shopify-section-{{ section.id }} .xstrape-header__mobile-thumb--placeholder::after {
    width: 24%;
    height: 24%;
    left: 38%;
    top: 18%;
    border-radius: 999px;
    border-bottom-color: transparent;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mega-title,
  #shopify-section-{{ section.id }} .xstrape-header__mobile-title {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    font-weight: 900;
    line-height: 1.08;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mega-title {
    margin-bottom: 4px;
    font-size: 0.98rem;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mega-text,
  #shopify-section-{{ section.id }} .xstrape-header__mobile-text {
    margin: 0;
    color: rgb(0 0 0 / 0.6);
    font-weight: 700;
    line-height: 1.28;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mega-text {
    font-size: 0.82rem;
  }

  #shopify-section-{{ section.id }} .xstrape-header__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--xstrape-header-accent);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    box-shadow: 0 8px 18px rgb(0 72 255 / 0.25);
  }

  #shopify-section-{{ section.id }} .xstrape-header__badge--hot,
  #shopify-section-{{ section.id }} .xstrape-header__badge--sale {
    background: #f5164f;
    box-shadow: 0 8px 18px rgb(245 22 79 / 0.25);
  }

  #shopify-section-{{ section.id }} .xstrape-header__arrow {
    color: rgb(0 0 0 / 0.42);
    font-size: 1.7rem;
    font-weight: 800;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mega-heading {
    margin: 8px 0 14px;
    color: #111;
    font-size: 0.82rem;
    font-weight: 900;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mega-links a {
    color: rgb(0 0 0 / 0.64);
    font-size: 0.94rem;
    font-weight: 750;
    line-height: 1.25;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mega-links a:hover {
    color: #111;
  }

  #shopify-section-{{ section.id }} .xstrape-header__feature {
    position: relative;
    display: flex;
    align-items: end;
    min-height: 100%;
    overflow: hidden;
    padding: 22px;
    border-radius: 24px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.5), rgb(0 0 0 / 0.78)),
      linear-gradient(145deg, #f2f2f2, #101010);
    color: #fff;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .xstrape-header__feature img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .xstrape-header__feature::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.02), rgb(0 0 0 / 0.72));
  }

  #shopify-section-{{ section.id }} .xstrape-header__feature-body {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .xstrape-header__feature-kicker {
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .xstrape-header__feature-title {
    font-size: 1.35rem;
    font-weight: 900;
    line-height: 1.08;
  }

  #shopify-section-{{ section.id }} .xstrape-header__feature-cta {
    display: inline-flex;
    width: fit-content;
    min-height: 32px;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    border-radius: 999px;
    background: #fff;
    color: #111;
    font-size: 0.78rem;
    font-weight: 900;
  }

  #shopify-section-{{ section.id }} .xstrape-header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .xstrape-header__icon {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 0;
    background: transparent;
    color: var(--xstrape-header-text);
    line-height: 0;
    text-decoration: none;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .xstrape-header__icon svg {
    width: 24px;
    height: 24px;
    stroke-width: 2.4;
  }

  #shopify-section-{{ section.id }} .xstrape-header__cart-count {
    position: absolute;
    top: 4px;
    right: 3px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--xstrape-header-accent);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 900;
    line-height: 17px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .xstrape-header__cart-count.is-empty {
    opacity: 0;
  }

  #shopify-section-{{ section.id }} .xstrape-header__menu-close {
    display: none;
  }

  html.xstrape-mobile-menu-open #shopify-section-{{ section.id }} .xstrape-header__menu-open {
    display: none;
  }

  html.xstrape-mobile-menu-open #shopify-section-{{ section.id }} .xstrape-header__menu-close {
    display: inline-flex;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-panel {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-scrim {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgb(0 0 0 / 0.62);
    opacity: 0;
    transition: opacity 0.24s ease;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-surface {
    position: absolute;
    top: var(--xstrape-mobile-panel-top, var(--xstrape-header-mobile-top-gap));
    left: var(--xstrape-header-side-gap);
    right: var(--xstrape-header-side-gap);
    height: var(--xstrape-mobile-panel-closed-height, var(--xstrape-header-bar-real-height, var(--xstrape-header-mobile-height)));
    max-height: var(--xstrape-mobile-panel-open-height, calc(100dvh - var(--xstrape-mobile-panel-top, var(--xstrape-header-mobile-top-gap)) - var(--xstrape-header-mobile-top-gap)));
    overflow: hidden;
    overscroll-behavior: contain;
    padding: calc(var(--xstrape-header-bar-real-height, var(--xstrape-header-mobile-height)) + var(--xstrape-mobile-menu-top-spacing)) var(--xstrape-mobile-menu-padding-x) var(--xstrape-mobile-menu-padding-bottom);
    border-radius: var(--xstrape-header-panel-radius);
    background: #f9f9f9;
    box-shadow: 0 22px 50px rgb(0 0 0 / 0.25);
    opacity: 0;
    transition:
      height 0.4s ease-in-out,
      opacity 0.15s ease-out,
      background-color 0.3s ease-in-out,
      box-shadow 0.3s cubic-bezier(0.165, 0.84, 0.44, 1) 0.08s;
    scrollbar-width: thin;
    scrollbar-color: rgb(0 0 0 / 0.28) transparent;
    will-change: height, opacity;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-panel.is-open {
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-panel.is-open .xstrape-header__mobile-scrim {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-panel.is-open .xstrape-header__mobile-surface {
    height: var(--xstrape-mobile-panel-open-height, calc(100dvh - var(--xstrape-mobile-panel-top, var(--xstrape-header-mobile-top-gap)) - var(--xstrape-header-mobile-top-gap)));
    overflow: auto;
    background: var(--xstrape-header-panel-bg);
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-level {
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity 0.28s ease-in-out 0.1s,
      transform 0.3s ease-in-out 0.08s;
    will-change: opacity, transform;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-panel.is-open .xstrape-header__mobile-level:not([hidden]) {
    opacity: 1;
    transform: translateY(0);
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-list {
    display: grid;
    gap: var(--xstrape-mobile-menu-gap);
    padding-top: 1px;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-level[hidden] {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-subhead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    margin: -1px 0 11px;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-back {
    position: relative;
    display: grid;
    place-items: center;
    width: 50px;
    height: 37px;
    border: 0;
    border-radius: 50px;
    background: #fff;
    color: #000;
    cursor: pointer;
    box-shadow:
      0 6px 6px -3px rgb(0 0 0 / 0.08),
      0 3px 3px -1.5px rgb(0 0 0 / 0.08),
      0 1px 1px -0.5px rgb(0 0 0 / 0.08),
      0 0 0 1px rgb(0 0 0 / 0.06);
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-back::before {
    content: "";
    width: 10px;
    height: 10px;
    border-bottom: 4px solid currentColor;
    border-left: 4px solid currentColor;
    transform: rotate(45deg);
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-subheading {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 40px;
    margin: 0;
    color: #000;
    font-size: var(--xstrape-mobile-title-font-size);
    font-weight: 900;
    line-height: 1;
    text-align: right;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-card {
    display: grid;
    grid-template-columns: var(--xstrape-mobile-card-image-size) minmax(0, 1fr) var(--xstrape-mobile-arrow-size);
    gap: var(--xstrape-mobile-card-content-gap);
    align-items: center;
    height: var(--xstrape-mobile-card-height);
    min-height: var(--xstrape-mobile-card-height);
    overflow: hidden;
    padding: var(--xstrape-mobile-card-padding);
    border-radius: var(--xstrape-mobile-card-radius);
    background: #fff;
    color: #000;
    text-decoration: none;
    box-shadow:
      0 6px 6px -3px rgb(0 0 0 / 0.06),
      0 3px 3px -1.5px rgb(0 0 0 / 0.06),
      0 1px 1px -0.5px rgb(0 0 0 / 0.06),
      0 0 0 1px rgb(0 0 0 / 0.06);
  }

  #shopify-section-{{ section.id }} button.xstrape-header__mobile-card {
    width: 100%;
    border: 0;
    font: inherit;
    cursor: pointer;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-thumb {
    width: var(--xstrape-mobile-card-image-size);
    height: var(--xstrape-mobile-card-image-size);
    border-radius: var(--xstrape-mobile-card-image-radius);
    background: #f3f3f3;
    box-shadow: none !important;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-thumb img {
    display: block;
    border-radius: var(--xstrape-mobile-card-image-radius);
    box-shadow: none !important;
    filter: none !important;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-sublist {
    padding-top: 0;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-all-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 53px;
    padding: 0 18px;
    border-radius: var(--xstrape-mobile-card-radius);
    background: #fff;
    color: #000;
    font-size: 15px;
    font-weight: 900;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    box-shadow:
      0 6px 6px -3px rgb(0 0 0 / 0.06),
      0 3px 3px -1.5px rgb(0 0 0 / 0.06),
      0 1px 1px -0.5px rgb(0 0 0 / 0.06),
      0 0 0 1px rgb(0 0 0 / 0.06);
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-body {
    display: block;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-title {
    display: flex;
    align-items: center;
    gap: var(--xstrape-mobile-card-content-gap);
    margin: 0;
    color: #000;
    font-size: var(--xstrape-mobile-title-font-size);
    font-weight: 900;
    line-height: var(--xstrape-mobile-title-font-size);
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-text {
    display: block;
    margin-top: 5px;
    color: #000;
    font-size: var(--xstrape-mobile-subtitle-font-size);
    font-weight: 400;
    line-height: var(--xstrape-mobile-subtitle-font-size);
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-title .xstrape-header__badge {
    min-height: calc(var(--xstrape-mobile-badge-font-size) + 10px);
    padding: 5px 6px 4px;
    border-radius: 10px;
    font-size: var(--xstrape-mobile-badge-font-size);
    font-weight: 900;
    line-height: calc(var(--xstrape-mobile-badge-font-size) + 1px);
    box-shadow:
      0 1.8px 3.2px rgb(0 0 0 / 0.1),
      0 1.7px 10.3px rgb(0 0 0 / 0.07),
      0 3.5px 10px rgb(0 0 0 / 0.05),
      0 7.5px 7px rgb(0 0 0 / 0.05);
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-arrow {
    position: relative;
    display: grid;
    place-items: center;
    justify-self: end;
    width: var(--xstrape-mobile-arrow-size);
    height: var(--xstrape-mobile-arrow-size);
    color: #000;
    font-size: 0;
    line-height: 0;
  }

  #shopify-section-{{ section.id }} .xstrape-header__mobile-arrow::before {
    content: "";
    width: 10px;
    height: 10px;
    border-top: 4px solid currentColor;
    border-right: 4px solid currentColor;
    transform: rotate(45deg);
  }

  @media screen and (max-width: 1149px) {
    html.xstrape-mobile-menu-open {
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} {
      --xstrape-header-side-gap: var(--xstrape-header-mobile-side-gap);
    }

    #shopify-section-{{ section.id }} .xstrape-header {
      padding: 0 0 var(--xstrape-header-mobile-top-gap);
    }

    #shopify-section-{{ section.id }} .xstrape-header__announcement {
      height: 36px;
      margin-bottom: 4px;
      font-size: 13px;
      font-weight: 850;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }}::before {
      height: 72px;
    }

    #shopify-section-{{ section.id }} .xstrape-header__bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: calc(100vw - (var(--xstrape-header-side-gap) * 2));
      min-height: var(--xstrape-header-mobile-height);
      padding: 0;
      gap: 0;
      border-radius: var(--xstrape-header-mobile-bar-radius);
      box-shadow:
        0 0 0 1px rgb(0 0 0 / 0.06),
        0 1px 1px -0.5px rgb(0 0 0 / 0.06),
        0 3px 3px -1.5px rgb(0 0 0 / 0.06),
        0 6px 6px -3px rgb(0 0 0 / 0.06),
        0 12px 12px -6px rgb(0 0 0 / 0.06),
        0 24px 24px -12px rgb(0 0 0 / 0.06);
    }

    #shopify-section-{{ section.id }} .xstrape-header__logo-image {
      max-width: min({{ section.settings.logo_mobile_width }}px, 45vw);
      max-height: calc(var(--xstrape-header-mobile-height) - var(--xstrape-header-mobile-logo-height-gap));
      transform: translateY(var(--xstrape-logo-mobile-y-offset));
    }

    #shopify-section-{{ section.id }} .xstrape-header__logo {
      height: var(--xstrape-header-mobile-height);
      flex: 1 1 auto;
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .xstrape-header__logo-link {
      height: var(--xstrape-header-mobile-height);
      padding-left: var(--xstrape-header-mobile-logo-left-padding);
      align-items: center;
      justify-content: flex-start;
    }

    #shopify-section-{{ section.id }} .xstrape-header__logo-text {
      font-size: clamp(1.18rem, 7vw, 1.7rem);
      transform: translateY(var(--xstrape-logo-mobile-y-offset));
    }

    #shopify-section-{{ section.id }} .xstrape-header__nav,
    #shopify-section-{{ section.id }} .xstrape-header__desktop-only {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .xstrape-header__actions {
      height: var(--xstrape-header-mobile-height);
      gap: 0;
      padding-right: 0;
    }

    #shopify-section-{{ section.id }} .xstrape-header__icon {
      width: var(--xstrape-header-mobile-icon-width);
      height: var(--xstrape-header-mobile-height);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} [data-xstrape-mobile-menu-toggle] {
      width: var(--xstrape-header-mobile-menu-icon-width);
    }
  }

  @media screen and (min-width: 1150px) {
    #shopify-section-{{ section.id }} .xstrape-header__mobile-only,
    #shopify-section-{{ section.id }} .xstrape-header__mobile-panel {
      display: none;
    }
  }

  @media screen and (max-width: 430px) {
    #shopify-section-{{ section.id }} .xstrape-header__mobile-card {
      grid-template-columns: var(--xstrape-mobile-card-image-size) minmax(0, 1fr) var(--xstrape-mobile-arrow-size);
      min-height: var(--xstrape-mobile-card-height);
    }

    #shopify-section-{{ section.id }} .xstrape-header__mobile-thumb {
      width: var(--xstrape-mobile-card-image-size);
      height: var(--xstrape-mobile-card-image-size);
    }
  }
</style>

<div class="xstrape-header" data-xstrape-header>
  {%- if section.settings.show_announcement and section.settings.announcement_text != blank -%}
    <div class="xstrape-header__announcement">
      <a class="xstrape-header__announcement-link" href="{{ section.settings.announcement_link | default: '#' }}">
        <span>{{ section.settings.announcement_text | escape }}</span>
        {%- if section.settings.announcement_link_text != blank -%}
          <span aria-hidden="true">|</span>
          <span class="xstrape-header__announcement-cta">{{ section.settings.announcement_link_text | escape }}</span>
        {%- endif -%}
        {%- if section.settings.show_announcement_info_icon -%}
          <span class="xstrape-header__announcement-info" aria-hidden="true">i</span>
        {%- endif -%}
      </a>
    </div>
  {%- endif -%}

  <div class="xstrape-header__bar" data-xstrape-header-bar>
    {%- capture logo_content -%}
      {%- if section.settings.logo != blank -%}
        {%- assign logo_render_width = section.settings.logo_width | times: 3 -%}
        {%- assign logo_alt = section.settings.logo.alt | default: section.settings.logo_text | default: shop.name -%}
        {{ section.settings.logo | image_url: width: logo_render_width | image_tag: loading: 'eager', class: 'xstrape-header__logo-image', alt: logo_alt }}
      {%- else -%}
        <span class="xstrape-header__logo-text">{{ section.settings.logo_text | default: shop.name | escape }}</span>
      {%- endif -%}
    {%- endcapture -%}

    {%- if request.page_type == 'index' -%}
      <h1 class="xstrape-header__logo">
        <a class="xstrape-header__logo-link" href="{{ routes.root_url }}">{{ logo_content }}</a>
      </h1>
    {%- else -%}
      <div class="xstrape-header__logo">
        <a class="xstrape-header__logo-link" href="{{ routes.root_url }}">{{ logo_content }}</a>
      </div>
    {%- endif -%}

    <nav class="xstrape-header__nav" aria-label="{{ section.settings.desktop_menu_label | escape }}">
      <ul class="xstrape-header__nav-list" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'desktop_item' -%}
            {%- liquid
              assign item_url = block.settings.link | default: '#'
              assign has_dropdown = block.settings.enable_dropdown
            -%}

            <li class="xstrape-header__nav-item" {{ block.shopify_attributes }}>
              {%- if has_dropdown -%}
                <details class="xstrape-header__nav-item" data-xstrape-mega-item>
                  <summary class="xstrape-header__nav-summary">
                    {%- if block.settings.split_title -%}
                      {{ block.settings.title | escape | replace: ' ', '<br>' }}
                    {%- else -%}
                      {{ block.settings.title | escape }}
                    {%- endif -%}
                  </summary>

                  <div class="xstrape-header__mega-panel">
                    <div class="xstrape-header__mega-inner">
                      <ul class="xstrape-header__mega-cards" role="list">
                        {%- if block.settings.card_1_title != blank -%}
                          <li>
                            <a class="xstrape-header__mega-card" href="{{ block.settings.card_1_link | default: item_url }}">
                              <span class="xstrape-header__thumb {% if block.settings.card_1_image == blank %}xstrape-header__thumb--placeholder{% endif %}">
                                {%- if block.settings.card_1_image != blank -%}
                                  {{ block.settings.card_1_image | image_url: width: 240 | image_tag: loading: 'lazy', sizes: '76px' }}
                                {%- endif -%}
                              </span>
                              <span>
                                <span class="xstrape-header__mega-title">
                                  {{ block.settings.card_1_title | escape }}
                                  {%- if block.settings.card_1_badge != blank -%}
                                    <span class="xstrape-header__badge xstrape-header__badge--{{ block.settings.card_1_badge_style }}">{{ block.settings.card_1_badge | escape }}</span>
                                  {%- endif -%}
                                </span>
                                {%- if block.settings.card_1_text != blank -%}
                                  <span class="xstrape-header__mega-text">{{ block.settings.card_1_text | escape }}</span>
                                {%- endif -%}
                              </span>
                              <span class="xstrape-header__arrow" aria-hidden="true">&rsaquo;</span>
                            </a>
                          </li>
                        {%- endif -%}

                        {%- if block.settings.card_2_title != blank -%}
                          <li>
                            <a class="xstrape-header__mega-card" href="{{ block.settings.card_2_link | default: item_url }}">
                              <span class="xstrape-header__thumb {% if block.settings.card_2_image == blank %}xstrape-header__thumb--placeholder{% endif %}">
                                {%- if block.settings.card_2_image != blank -%}
                                  {{ block.settings.card_2_image | image_url: width: 240 | image_tag: loading: 'lazy', sizes: '76px' }}
                                {%- endif -%}
                              </span>
                              <span>
                                <span class="xstrape-header__mega-title">
                                  {{ block.settings.card_2_title | escape }}
                                  {%- if block.settings.card_2_badge != blank -%}
                                    <span class="xstrape-header__badge xstrape-header__badge--{{ block.settings.card_2_badge_style }}">{{ block.settings.card_2_badge | escape }}</span>
                                  {%- endif -%}
                                </span>
                                {%- if block.settings.card_2_text != blank -%}
                                  <span class="xstrape-header__mega-text">{{ block.settings.card_2_text | escape }}</span>
                                {%- endif -%}
                              </span>
                              <span class="xstrape-header__arrow" aria-hidden="true">&rsaquo;</span>
                            </a>
                          </li>
                        {%- endif -%}

                        {%- if block.settings.card_3_title != blank -%}
                          <li>
                            <a class="xstrape-header__mega-card" href="{{ block.settings.card_3_link | default: item_url }}">
                              <span class="xstrape-header__thumb {% if block.settings.card_3_image == blank %}xstrape-header__thumb--placeholder{% endif %}">
                                {%- if block.settings.card_3_image != blank -%}
                                  {{ block.settings.card_3_image | image_url: width: 240 | image_tag: loading: 'lazy', sizes: '76px' }}
                                {%- endif -%}
                              </span>
                              <span>
                                <span class="xstrape-header__mega-title">
                                  {{ block.settings.card_3_title | escape }}
                                  {%- if block.settings.card_3_badge != blank -%}
                                    <span class="xstrape-header__badge xstrape-header__badge--{{ block.settings.card_3_badge_style }}">{{ block.settings.card_3_badge | escape }}</span>
                                  {%- endif -%}
                                </span>
                                {%- if block.settings.card_3_text != blank -%}
                                  <span class="xstrape-header__mega-text">{{ block.settings.card_3_text | escape }}</span>
                                {%- endif -%}
                              </span>
                              <span class="xstrape-header__arrow" aria-hidden="true">&rsaquo;</span>
                            </a>
                          </li>
                        {%- endif -%}
                      </ul>

                      <div class="xstrape-header__mega-link-grid">
                        {%- for index in (1..3) -%}
                          {%- liquid
                            assign heading_key = 'link_heading_' | append: index
                            assign list_key = 'link_list_' | append: index
                            assign link_list = block.settings[list_key]
                            assign heading = block.settings[heading_key] | default: link_list.title
                          -%}
                          {%- if link_list != blank and link_list.links.size > 0 -%}
                            <div>
                              <p class="xstrape-header__mega-heading">{{ heading | escape }}</p>
                              <ul class="xstrape-header__mega-links" role="list">
                                {%- for link in link_list.links -%}
                                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                                {%- endfor -%}
                              </ul>
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>

                      <a class="xstrape-header__feature" href="{{ block.settings.feature_link | default: item_url }}">
                        {%- if block.settings.feature_image != blank -%}
                          {{ block.settings.feature_image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '280px' }}
                        {%- endif -%}
                        <span class="xstrape-header__feature-body">
                          {%- if block.settings.feature_kicker != blank -%}
                            <span class="xstrape-header__feature-kicker">{{ block.settings.feature_kicker | escape }}</span>
                          {%- endif -%}
                          <span class="xstrape-header__feature-title">{{ block.settings.feature_title | default: block.settings.title | escape }}</span>
                          {%- if block.settings.feature_button_text != blank -%}
                            <span class="xstrape-header__feature-cta">{{ block.settings.feature_button_text | escape }}</span>
                          {%- endif -%}
                        </span>
                      </a>
                    </div>
                  </div>
                </details>
              {%- else -%}
                <a class="xstrape-header__nav-link {% if block.settings.highlight %}xstrape-header__nav-link--highlight{% endif %}" href="{{ item_url }}">
                  {%- if block.settings.split_title -%}
                    {{ block.settings.title | escape | replace: ' ', '<br>' }}
                  {%- else -%}
                    {{ block.settings.title | escape }}
                  {%- endif -%}
                </a>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    <ul class="xstrape-header__actions" role="list">
      {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
        <li class="xstrape-header__desktop-only">
          {%- render 'localization-selector', type: 'country', show_country_name: section.settings.show_country_name, show_country_flag: section.settings.show_country_flag, popover_vertical_position: 'end' -%}
        </li>
      {%- endif -%}

      {%- if section.settings.show_search -%}
        <li>
          <a class="xstrape-header__icon" href="{{ routes.search_url }}" aria-controls="search-drawer">
            <span class="sr-only">{{ 'header.general.search' | t }}</span>
            {%- render 'icon' with 'search' -%}
          </a>
        </li>
      {%- endif -%}

      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <li class="xstrape-header__desktop-only">
          <shopify-account menu="{{ section.settings.customer_account_menu }}">
            <div slot="signed-out-avatar" class="xstrape-header__icon">
              <span class="sr-only">{{ 'header.general.login' | t }}</span>
              {%- render 'icon' with 'account' -%}
            </div>
          </shopify-account>
        </li>
      {%- endif -%}

      {%- if section.settings.show_cart -%}
        <li>
          <a class="xstrape-header__icon" href="{{ routes.cart_url }}" data-no-instant {% if settings.cart_type != 'page' and request.page_type != 'cart' %}aria-controls="cart-drawer"{% endif %}>
            <span class="sr-only">{{ 'header.general.cart' | t }}</span>
            {%- render 'icon' with 'cart' -%}
            <span class="xstrape-header__cart-count {% if cart.item_count == 0 %}is-empty{% endif %}" aria-hidden="true">{{ cart.item_count }}</span>
          </a>
        </li>
      {%- endif -%}

      <li class="xstrape-header__mobile-only">
        <button class="xstrape-header__icon" type="button" aria-controls="xstrape-mobile-panel-{{ section.id }}" aria-expanded="false" data-xstrape-mobile-menu-toggle>
          <span class="sr-only">{{ 'header.general.menu' | t }}</span>
          <span class="xstrape-header__menu-open">{%- render 'icon' with 'hamburger' -%}</span>
          <span class="xstrape-header__menu-close">{%- render 'icon' with 'close', width: 25, height: 25 -%}</span>
        </button>
      </li>
    </ul>
  </div>

  <div id="xstrape-mobile-panel-{{ section.id }}" class="xstrape-header__mobile-panel" hidden>
    <button class="xstrape-header__mobile-scrim" type="button" aria-label="{{ 'general.accessibility.close' | t | escape }}" data-xstrape-mobile-menu-close></button>
    <div class="xstrape-header__mobile-surface" role="dialog" aria-modal="true" aria-label="{{ 'header.general.menu' | t | escape }}" tabindex="-1">
      <div class="xstrape-header__mobile-level" data-xstrape-mobile-main>
        <ul class="xstrape-header__mobile-list" role="list">
          {%- assign has_mobile_cards = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'mobile_card' -%}
              {%- assign has_mobile_cards = true -%}
              {%- liquid
                assign has_submenu = false
                if block.settings.enable_submenu
                  for index in (1..6)
                    assign child_title_key = 'child_' | append: index | append: '_title'
                    if block.settings[child_title_key] != blank
                      assign has_submenu = true
                    endif
                  endfor

                  if block.settings.submenu_all_label != blank and block.settings.submenu_all_link != blank
                    assign has_submenu = true
                  endif
                endif

                assign mobile_card_title_handle = block.settings.title | handleize
                assign mobile_card_submenu_handle = block.settings.submenu_title | handleize
                for submenu_block in section.blocks
                  if submenu_block.type == 'mobile_submenu_item'
                    assign submenu_parent_handle = submenu_block.settings.parent_title | handleize
                    if submenu_block.settings.title != blank and submenu_parent_handle == mobile_card_title_handle
                      assign has_submenu = true
                    elsif submenu_block.settings.title != blank and mobile_card_submenu_handle != blank and submenu_parent_handle == mobile_card_submenu_handle
                      assign has_submenu = true
                    endif
                  endif
                endfor

                assign mobile_image_asset = block.settings.image_asset | strip
                if mobile_image_asset == blank
                  case block.settings.title
                    when 'Cases'
                      assign mobile_image_asset = 'xstrape-menu-cases.jpg'
                    when 'Watch Bands'
                      assign mobile_image_asset = 'xstrape-menu-watch-bands.jpg'
                    when 'Find My® Tracking'
                      assign mobile_image_asset = 'xstrape-menu-find-my.jpg'
                    when 'Charging'
                      assign mobile_image_asset = 'xstrape-menu-charging.jpg'
                    when 'Wallets'
                      assign mobile_image_asset = 'xstrape-menu-wallets.jpg'
                    when 'Lifestyle Gear'
                      assign mobile_image_asset = 'xstrape-menu-lifestyle.jpg'
                    when 'Tracking'
                      assign mobile_image_asset = 'xstrape-menu-tracking.jpg'
                    when 'AirTag Accessories'
                      assign mobile_image_asset = 'xstrape-menu-tracking.jpg'
                    when 'Sale'
                      assign mobile_image_asset = 'xstrape-menu-sale.png'
                  endcase
                endif
              -%}

              {%- capture mobile_card_inner -%}
                <span class="xstrape-header__mobile-thumb {% if block.settings.image == blank and mobile_image_asset == blank %}xstrape-header__mobile-thumb--placeholder{% endif %}">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', sizes: '74px' }}
                  {%- elsif mobile_image_asset != blank -%}
                    <img src="{{ mobile_image_asset | asset_url }}" alt="" loading="lazy">
                  {%- endif -%}
                </span>
                <span class="xstrape-header__mobile-body">
                  <span class="xstrape-header__mobile-title">
                    {{ block.settings.title | escape }}
                    {%- if block.settings.badge != blank -%}
                      <span class="xstrape-header__badge xstrape-header__badge--{{ block.settings.badge_style }}">{{ block.settings.badge | escape }}</span>
                    {%- endif -%}
                  </span>
                  {%- if block.settings.subtitle != blank -%}
                    <span class="xstrape-header__mobile-text">{{ block.settings.subtitle | escape }}</span>
                  {%- endif -%}
                </span>
                <span class="xstrape-header__mobile-arrow" aria-hidden="true">&rsaquo;</span>
              {%- endcapture -%}

              <li {{ block.shopify_attributes }}>
                {%- if has_submenu -%}
                  <button class="xstrape-header__mobile-card" type="button" aria-controls="xstrape-mobile-submenu-{{ section.id }}-{{ block.id }}" data-xstrape-mobile-submenu-open="{{ block.id }}">
                    {{ mobile_card_inner }}
                  </button>
                {%- else -%}
                  <a class="xstrape-header__mobile-card" href="{{ block.settings.link | default: '#' }}">
                    {{ mobile_card_inner }}
                  </a>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}

          {%- unless has_mobile_cards -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'desktop_item' -%}
                <li>
                  <a class="xstrape-header__mobile-card" href="{{ block.settings.link | default: '#' }}">
                    <span class="xstrape-header__mobile-thumb xstrape-header__mobile-thumb--placeholder"></span>
                    <span class="xstrape-header__mobile-body">
                      <span class="xstrape-header__mobile-title">{{ block.settings.title | escape }}</span>
                      {%- if block.settings.card_1_text != blank -%}
                        <span class="xstrape-header__mobile-text">{{ block.settings.card_1_text | escape }}</span>
                      {%- endif -%}
                    </span>
                    <span class="xstrape-header__mobile-arrow" aria-hidden="true">&rsaquo;</span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endunless -%}
        </ul>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'mobile_card' -%}
          {%- liquid
            assign has_submenu = false
            if block.settings.enable_submenu
              for index in (1..6)
                assign child_title_key = 'child_' | append: index | append: '_title'
                if block.settings[child_title_key] != blank
                  assign has_submenu = true
                endif
              endfor

              if block.settings.submenu_all_label != blank and block.settings.submenu_all_link != blank
                assign has_submenu = true
              endif
            endif

            assign mobile_card_title_handle = block.settings.title | handleize
            assign mobile_card_submenu_handle = block.settings.submenu_title | handleize
            for submenu_block in section.blocks
              if submenu_block.type == 'mobile_submenu_item'
                assign submenu_parent_handle = submenu_block.settings.parent_title | handleize
                if submenu_block.settings.title != blank and submenu_parent_handle == mobile_card_title_handle
                  assign has_submenu = true
                elsif submenu_block.settings.title != blank and mobile_card_submenu_handle != blank and submenu_parent_handle == mobile_card_submenu_handle
                  assign has_submenu = true
                endif
              endif
            endfor
          -%}

          {%- if has_submenu -%}
            <div id="xstrape-mobile-submenu-{{ section.id }}-{{ block.id }}" class="xstrape-header__mobile-level" data-xstrape-mobile-submenu="{{ block.id }}" hidden>
              <div class="xstrape-header__mobile-subhead">
                <button class="xstrape-header__mobile-back" type="button" aria-label="返回上一级菜单" data-xstrape-mobile-submenu-back></button>
                <p class="xstrape-header__mobile-subheading">{{ block.settings.submenu_title | default: block.settings.title | escape }}</p>
              </div>
              <ul class="xstrape-header__mobile-list xstrape-header__mobile-sublist" role="list">
                {%- liquid
                  assign has_submenu_item_blocks = false
                  assign mobile_card_title_handle = block.settings.title | handleize
                  assign mobile_card_submenu_handle = block.settings.submenu_title | handleize
                -%}

                {%- for submenu_block in section.blocks -%}
                  {%- liquid
                    assign is_matching_submenu_item = false
                    assign submenu_parent_handle = submenu_block.settings.parent_title | handleize
                    if submenu_block.type == 'mobile_submenu_item' and submenu_block.settings.title != blank
                      if submenu_parent_handle == mobile_card_title_handle
                        assign is_matching_submenu_item = true
                      elsif mobile_card_submenu_handle != blank and submenu_parent_handle == mobile_card_submenu_handle
                        assign is_matching_submenu_item = true
                      endif
                    endif

                    assign submenu_item_style = submenu_block.settings.item_style | default: 'card'
                  -%}

                  {%- if is_matching_submenu_item and submenu_item_style != 'button' -%}
                    {%- liquid
                      assign has_submenu_item_blocks = true
                      assign child_title = submenu_block.settings.title
                      assign child_link = submenu_block.settings.link | default: '#'
                      assign child_image = submenu_block.settings.image
                      assign child_image_asset = submenu_block.settings.image_asset | strip
                      assign child_badge = submenu_block.settings.badge
                      assign child_badge_normalized = child_badge | upcase
                      assign child_badge_style = 'new'
                      if child_badge_normalized contains 'HOT'
                        assign child_badge_style = 'hot'
                      elsif child_badge_normalized contains 'SALE' or child_badge_normalized contains 'FEATURED'
                        assign child_badge_style = 'sale'
                      endif
                    -%}
                    <li {{ submenu_block.shopify_attributes }}>
                      <a class="xstrape-header__mobile-card" href="{{ child_link }}">
                        <span class="xstrape-header__mobile-thumb {% if child_image == blank and child_image_asset == blank %}xstrape-header__mobile-thumb--placeholder{% endif %}">
                          {%- if child_image != blank -%}
                            {{ child_image | image_url: width: 320 | image_tag: loading: 'lazy', sizes: '74px' }}
                          {%- elsif child_image_asset != blank -%}
                            <img src="{{ child_image_asset | asset_url }}" alt="" loading="lazy">
                          {%- endif -%}
                        </span>
                        <span class="xstrape-header__mobile-body">
                          <span class="xstrape-header__mobile-title">
                            {{ child_title | escape }}
                            {%- if child_badge != blank -%}
                              <span class="xstrape-header__badge xstrape-header__badge--{{ child_badge_style }}">{{ child_badge | escape }}</span>
                            {%- endif -%}
                          </span>
                        </span>
                        <span class="xstrape-header__mobile-arrow" aria-hidden="true">&rsaquo;</span>
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}

                {%- for submenu_block in section.blocks -%}
                  {%- liquid
                    assign is_matching_submenu_item = false
                    assign submenu_parent_handle = submenu_block.settings.parent_title | handleize
                    if submenu_block.type == 'mobile_submenu_item' and submenu_block.settings.title != blank
                      if submenu_parent_handle == mobile_card_title_handle
                        assign is_matching_submenu_item = true
                      elsif mobile_card_submenu_handle != blank and submenu_parent_handle == mobile_card_submenu_handle
                        assign is_matching_submenu_item = true
                      endif
                    endif

                    assign submenu_item_style = submenu_block.settings.item_style | default: 'card'
                  -%}

                  {%- if is_matching_submenu_item and submenu_item_style == 'button' -%}
                    {%- assign has_submenu_item_blocks = true -%}
                    <li {{ submenu_block.shopify_attributes }}>
                      <a class="xstrape-header__mobile-all-link" href="{{ submenu_block.settings.link | default: '#' }}">{{ submenu_block.settings.title | escape }}</a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}

                {%- unless has_submenu_item_blocks -%}
                  {%- for index in (1..6) -%}
                    {%- liquid
                      assign child_title_key = 'child_' | append: index | append: '_title'
                      assign child_link_key = 'child_' | append: index | append: '_link'
                      assign child_image_key = 'child_' | append: index | append: '_image'
                      assign child_image_asset_key = 'child_' | append: index | append: '_image_asset'
                      assign child_badge_key = 'child_' | append: index | append: '_badge'
                      assign child_title = block.settings[child_title_key]
                      assign child_link = block.settings[child_link_key] | default: block.settings.link | default: '#'
                      assign child_image = block.settings[child_image_key]
                      assign child_image_asset = block.settings[child_image_asset_key] | strip
                      assign child_badge = block.settings[child_badge_key]
                      assign child_badge_normalized = child_badge | upcase
                      assign child_badge_style = 'new'
                      if child_badge_normalized contains 'HOT'
                        assign child_badge_style = 'hot'
                      elsif child_badge_normalized contains 'SALE' or child_badge_normalized contains 'FEATURED'
                        assign child_badge_style = 'sale'
                      endif
                    -%}

                    {%- if child_title != blank -%}
                      <li>
                        <a class="xstrape-header__mobile-card" href="{{ child_link }}">
                          <span class="xstrape-header__mobile-thumb {% if child_image == blank and child_image_asset == blank %}xstrape-header__mobile-thumb--placeholder{% endif %}">
                            {%- if child_image != blank -%}
                              {{ child_image | image_url: width: 320 | image_tag: loading: 'lazy', sizes: '74px' }}
                            {%- elsif child_image_asset != blank -%}
                              <img src="{{ child_image_asset | asset_url }}" alt="" loading="lazy">
                            {%- endif -%}
                          </span>
                          <span class="xstrape-header__mobile-body">
                            <span class="xstrape-header__mobile-title">
                              {{ child_title | escape }}
                              {%- if child_badge != blank -%}
                                <span class="xstrape-header__badge xstrape-header__badge--{{ child_badge_style }}">{{ child_badge | escape }}</span>
                              {%- endif -%}
                            </span>
                          </span>
                          <span class="xstrape-header__mobile-arrow" aria-hidden="true">&rsaquo;</span>
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}

                  {%- if block.settings.submenu_all_label != blank and block.settings.submenu_all_link != blank -%}
                    <li>
                      <a class="xstrape-header__mobile-all-link" href="{{ block.settings.submenu_all_link }}">{{ block.settings.submenu_all_label | escape }}</a>
                    </li>
                  {%- endif -%}
                {%- endunless -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    const bar = section.querySelector('[data-xstrape-header-bar]');
    const panel = section.querySelector('#xstrape-mobile-panel-{{ section.id }}');
    const mobileSurface = panel?.querySelector('.xstrape-header__mobile-surface');
    const mobileMain = panel?.querySelector('[data-xstrape-mobile-main]');
    const mobileSubmenus = panel?.querySelectorAll('[data-xstrape-mobile-submenu]');
    const toggles = section.querySelectorAll('[data-xstrape-mobile-menu-toggle]');
    const desktopQuery = window.matchMedia('(min-width: 1150px)');
    let closeTimer;

    const updateMetrics = () => {
      if (!bar) return;
      const rect = bar.getBoundingClientRect();
      const sectionStyle = window.getComputedStyle(section);
      const bottomGap = Number.parseFloat(sectionStyle.getPropertyValue('--xstrape-header-mobile-top-gap')) || 0;
      const viewportHeight = window.visualViewport?.height || window.innerHeight || document.documentElement.clientHeight;
      const panelOpenHeight = Math.max(rect.height, Math.round(viewportHeight - rect.top - bottomGap));

      section.style.setProperty('--xstrape-header-bar-real-height', `${Math.round(rect.height)}px`);
      section.style.setProperty('--xstrape-mobile-panel-top', `${Math.round(rect.top)}px`);
      section.style.setProperty('--xstrape-mobile-panel-closed-height', `${Math.round(rect.height)}px`);
      section.style.setProperty('--xstrape-mobile-panel-open-height', `${panelOpenHeight}px`);
      document.documentElement.style.setProperty('--header-height', `${Math.round(section.clientHeight)}px`);
    };

    const closeDesktopItems = (activeItem) => {
      section.querySelectorAll('[data-xstrape-mega-item]').forEach((item) => {
        if (item !== activeItem) item.removeAttribute('open');
      });
    };

    section.querySelectorAll('[data-xstrape-mega-item]').forEach((item) => {
      item.addEventListener('mouseenter', () => {
        if (!desktopQuery.matches) return;
        closeDesktopItems(item);
        item.setAttribute('open', '');
      });

      item.addEventListener('mouseleave', () => {
        if (!desktopQuery.matches) return;
        item.removeAttribute('open');
      });

      item.querySelector('summary')?.addEventListener('click', () => {
        if (!desktopQuery.matches) return;
        closeDesktopItems(item);
      });
    });

    const resetMobileSubmenus = () => {
      if (mobileMain) mobileMain.hidden = false;
      mobileSubmenus?.forEach((submenu) => {
        submenu.hidden = true;
      });
      mobileSurface?.scrollTo({ top: 0, behavior: 'auto' });
    };

    const openMobileSubmenu = (id) => {
      const submenu = Array.from(mobileSubmenus || []).find((item) => item.getAttribute('data-xstrape-mobile-submenu') === id);
      if (!submenu || !mobileMain) return;

      mobileMain.hidden = true;
      mobileSubmenus?.forEach((item) => {
        item.hidden = item !== submenu;
      });
      mobileSurface?.scrollTo({ top: 0, behavior: 'auto' });
    };

    const setOpen = (open) => {
      if (!panel || toggles.length === 0) return;
      window.clearTimeout(closeTimer);

      toggles.forEach((toggle) => {
        toggle.setAttribute('aria-expanded', String(open));
      });

      document.documentElement.classList.toggle('xstrape-mobile-menu-open', open);

      if (open) {
        updateMetrics();
        resetMobileSubmenus();
        panel.hidden = false;
        panel.offsetHeight;
        panel.classList.add('is-open');
        panel.querySelector('.xstrape-header__mobile-surface')?.focus({ preventScroll: true });
      } else {
        panel.classList.remove('is-open');
        resetMobileSubmenus();
        closeTimer = window.setTimeout(() => {
          panel.hidden = true;
        }, 430);
      }
    };

    toggles.forEach((toggle) => {
      toggle.addEventListener('click', (event) => {
        if (desktopQuery.matches) return;
        event.preventDefault();
        event.stopPropagation();
        setOpen(!panel?.classList.contains('is-open'));
      });
    });

    panel?.addEventListener('click', (event) => {
      const submenuTrigger = event.target.closest('[data-xstrape-mobile-submenu-open]');
      if (submenuTrigger) {
        event.preventDefault();
        event.stopPropagation();
        openMobileSubmenu(submenuTrigger.getAttribute('data-xstrape-mobile-submenu-open'));
        return;
      }

      if (event.target.closest('[data-xstrape-mobile-submenu-back]')) {
        event.preventDefault();
        event.stopPropagation();
        resetMobileSubmenus();
        return;
      }

      if (event.target.closest('[data-xstrape-mobile-menu-close]') || event.target.closest('a')) {
        setOpen(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeDesktopItems();
        if (panel?.classList.contains('is-open')) setOpen(false);
      }
    });

    const onDesktopChange = (event) => {
      if (event.matches) setOpen(false);
    };

    updateMetrics();
    window.addEventListener('resize', updateMetrics, { passive: true });
    window.visualViewport?.addEventListener('resize', updateMetrics, { passive: true });

    if (desktopQuery.addEventListener) {
      desktopQuery.addEventListener('change', onDesktopChange);
    } else {
      desktopQuery.addListener(onDesktopChange);
    }
  })();
</script>

