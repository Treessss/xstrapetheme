{%- comment -%}
  Product series selector driven by product metafields.

  Supported product/collection metafields:
  - custom.product_series: list.product_reference
  - custom.related_series_products: list.product_reference / product_reference / collection_reference
  - custom.related_series: list.product_reference / product_reference / collection_reference
  - custom.related_products: list.product_reference
  - custom.associated_products: list.product_reference
  - custom.color_series: list.product_reference
  - custom.series_products: list.product_reference

  Supported collection reference metafields:
  - custom.series_collection: collection_reference
  - custom.related_collection: collection_reference

  Optional metafields:
  - custom.series_label: single_line_text_field
  - custom.series_option_name: single_line_text_field
{%- endcomment -%}

{%- liquid
  assign series_source = product.metafields.custom.product_series.value

  if series_source == blank
    assign series_source = product.metafields.custom.related_series_products.value
  endif

  if series_source == blank
    assign series_source = product.metafields.custom.related_series.value
  endif

  if series_source == blank
    assign series_source = product.metafields.custom.related_products.value
  endif

  if series_source == blank
    assign series_source = product.metafields.custom.associated_products.value
  endif

  if series_source == blank
    assign series_source = product.metafields.custom.color_series.value
  endif

  if series_source == blank
    assign series_source = product.metafields.custom.series_products.value
  endif

  assign series_products = blank
  assign single_series_product = blank

  if series_source != blank
    if series_source.products != blank or series_source.products_count != blank
      assign series_products = series_source.products
    elsif series_source.featured_media != blank or series_source.selected_or_first_available_variant != blank
      assign single_series_product = series_source
    else
      assign series_products = series_source
    endif
  endif

  if series_products == blank and single_series_product == blank
    assign series_collection = product.metafields.custom.series_collection.value

    if series_collection == blank
      assign series_collection = product.metafields.custom.related_collection.value
    endif

    if series_collection != blank
      assign series_products = series_collection.products
    endif
  endif
-%}

{%- if series_products != blank or single_series_product != blank -%}
  {%- liquid
    assign current_series_label = product.metafields.custom.series_label.value | default: product.metafields.custom.color.value | default: product.selected_or_first_available_variant.option1 | default: product.title

    if current_series_label == blank or current_series_label == 'Default Title'
      assign current_series_label = product.title
    endif

    assign series_option_name = product.metafields.custom.series_option_name.value | default: 'Color'
    assign current_product_in_series = false

    for series_product in series_products
      if series_product.id == product.id
        assign current_product_in_series = true
        break
      endif
    endfor

    if single_series_product != blank and single_series_product.id == product.id
      assign current_product_in_series = true
    endif
  -%}

  <div class="product-info__series-selector" data-product-series-selector>
    <div class="product-info__series-heading">
      {{- series_option_name | escape -}}: <span>{{ current_series_label | escape }}</span>
    </div>

    <div class="product-info__series-list" role="list">
      {%- unless current_product_in_series -%}
        {%- liquid
          assign tile_image = product.featured_media
          assign tile_label = current_series_label
        -%}

        <a class="product-info__series-tile is-selected" href="{{ product.url }}" aria-current="page" role="listitem" data-instant>
          <span class="product-info__series-image">
            {%- if tile_image != blank -%}
              {{- tile_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '120,180,240,360', sizes: '(max-width: 699px) 72px, 84px', alt: tile_label -}}
            {%- endif -%}
          </span>
          <span class="product-info__series-label">{{ tile_label | escape }}</span>
        </a>
      {%- endunless -%}

      {%- if single_series_product != blank -%}
        {%- liquid
          assign tile_label = single_series_product.metafields.custom.series_label.value | default: single_series_product.metafields.custom.color.value | default: single_series_product.selected_or_first_available_variant.option1 | default: single_series_product.title
          assign tile_image = single_series_product.featured_media
          assign is_current_series_product = false

          if tile_label == blank or tile_label == 'Default Title'
            assign tile_label = single_series_product.title
          endif

          if single_series_product.id == product.id
            assign is_current_series_product = true
          endif
        -%}

        <a
          class="product-info__series-tile{% if is_current_series_product %} is-selected{% endif %}"
          href="{{ single_series_product.url }}"
          {% if is_current_series_product %}aria-current="page"{% endif %}
          role="listitem"
          data-instant
        >
          <span class="product-info__series-image">
            {%- if tile_image != blank -%}
              {{- tile_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '120,180,240,360', sizes: '(max-width: 699px) 72px, 84px', alt: tile_label -}}
            {%- endif -%}
          </span>
          <span class="product-info__series-label">{{ tile_label | escape }}</span>
        </a>
      {%- endif -%}

      {%- for series_product in series_products -%}
        {%- liquid
          assign tile_label = series_product.metafields.custom.series_label.value | default: series_product.metafields.custom.color.value | default: series_product.selected_or_first_available_variant.option1 | default: series_product.title
          assign tile_image = series_product.featured_media
          assign is_current_series_product = false

          if tile_label == blank or tile_label == 'Default Title'
            assign tile_label = series_product.title
          endif

          if series_product.id == product.id
            assign is_current_series_product = true
          endif
        -%}

        <a
          class="product-info__series-tile{% if is_current_series_product %} is-selected{% endif %}"
          href="{{ series_product.url }}"
          {% if is_current_series_product %}aria-current="page"{% endif %}
          role="listitem"
          data-instant
        >
          <span class="product-info__series-image">
            {%- if tile_image != blank -%}
              {{- tile_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '120,180,240,360', sizes: '(max-width: 699px) 72px, 84px', alt: tile_label -}}
            {%- endif -%}
          </span>
          <span class="product-info__series-label">{{ tile_label | escape }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
