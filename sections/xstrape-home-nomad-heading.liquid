{{ 'xstrape-home.css' | asset_url | stylesheet_tag }}

<section
  class="xstrape-home-scope xh-nomad-heading {% if section.settings.kicker == blank %}xh-nomad-heading--solo{% endif %}"
  style="--xh-page-bg: {{ section.settings.page_background | default: '#f3f3f3' }}; --xh-text: {{ section.settings.text_color | default: '#000000' }};"
>
  <div class="xh-nomad-heading__content">
    {% if section.settings.kicker != blank %}
      <h3>{{ section.settings.kicker | escape }}</h3>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading | escape }}</h2>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Xstrape Nomad heading",
  "class": "shopify-section--xstrape-nomad-heading",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "Quality. Character. Tradition." },
    { "type": "text", "id": "heading", "label": "Large heading", "default": "Horween Leather" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "page_background", "label": "Background", "default": "#f3f3f3" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" }
  ],
  "presets": [
    { "name": "Xstrape Nomad heading" }
  ]
}
{% endschema %}
