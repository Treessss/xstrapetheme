{{ 'xstrape-home.css' | asset_url | stylesheet_tag }}

<section
  class="xstrape-home-scope xh-section xh-community"
  style="--xh-page-bg: {{ section.settings.page_background | default: '#f3f3f3' }}; --xh-text: {{ section.settings.text_color | default: '#111111' }}; --xh-muted: {{ section.settings.muted_text_color | default: '#6c6c6c' }};"
>
  <div class="xh-container">
    <div class="xh-section-header">
      <div>
        {% if section.settings.community_kicker != blank %}
          <p class="xh-eyebrow">{{ section.settings.community_kicker | escape }}</p>
        {% endif %}
        {% if section.settings.community_title != blank %}
          <h2 class="xh-heading">{{ section.settings.community_title | escape }}</h2>
        {% endif %}
      </div>
    </div>

    <div class="xh-community-list">
      {% for block in section.blocks %}
        <a class="xh-community-card {% if block.settings.image == blank %}xh-community-card--text{% endif %}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <span class="xh-community-card__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 44vw, 25vw', widths: '360,540,720,900,1200'
              }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {% endif %}
          </span>
          {% if block.settings.label != blank %}
            <span class="xh-community-card__label">{{ block.settings.label | escape }}</span>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "社区展示",
  "class": "shopify-section--xstrape-community",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "community_kicker",
      "label": "小标题",
      "default": "In the wild"
    },
    {
      "type": "text",
      "id": "community_title",
      "label": "标题",
      "default": "From the Community"
    },
    {
      "type": "header",
      "content": "颜色"
    },
    {
      "type": "color",
      "id": "page_background",
      "label": "背景",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "次要文字",
      "default": "#6c6c6c"
    }
  ],
  "blocks": [
    {
      "type": "community",
      "name": "社区卡片",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "标签文字",
          "default": "Road setup"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "url",
          "id": "link",
          "label": "链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "社区展示"
    }
  ]
}
{% endschema %}
