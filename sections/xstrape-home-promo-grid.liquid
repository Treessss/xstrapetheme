{{ 'xstrape-home.css' | asset_url | stylesheet_tag }}

<section
  class="xstrape-home-scope xh-section"
  style="--xh-page-bg: {{ section.settings.page_background | default: '#f3f3f3' }}; --xh-text: {{ section.settings.text_color | default: '#111111' }}; --xh-muted: {{ section.settings.muted_text_color | default: '#6c6c6c' }};"
>
  <div class="xh-container">
    <div class="xh-promo-grid">
      {% for block in section.blocks %}
        <a class="xh-media-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <span class="xh-media-card__image">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1800
                | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 100vw, 50vw', widths: '600,900,1200,1500,1800'
              }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'xh-media-card__placeholder' }}
            {% endif %}
          </span>
          <span class="xh-media-card__body">
            {% if block.settings.kicker != blank %}
              <span class="xh-eyebrow" style="color: rgb(255 255 255 / 0.78);">{{ block.settings.kicker | escape }}</span>
            {% endif %}
            {% if block.settings.title != blank %}
              <span class="xh-media-card__title">{{ block.settings.title | escape }}</span>
            {% endif %}
            {% if block.settings.text != blank %}
              <span class="xh-media-card__text">{{ block.settings.text | escape }}</span>
            {% endif %}
            {% if block.settings.button_text != blank %}
              <span class="xh-pill-button" style="margin-top: 1.15rem;">{{ block.settings.button_text | escape }}</span>
            {% endif %}
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "促销图文区",
  "class": "shopify-section--xstrape-promo-grid",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "page_background",
      "label": "背景",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "次要文字",
      "default": "#6c6c6c"
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "促销卡片",
      "settings": [
        {
          "type": "text",
          "id": "kicker",
          "label": "小标题"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Promo title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "文字"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "按钮文字",
          "default": "Shop now"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "url",
          "id": "link",
          "label": "链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "促销图文区"
    }
  ]
}
{% endschema %}
