{{ 'xstrape-home.css' | asset_url | stylesheet_tag }}

<section
  class="xstrape-home-scope xh-section xh-categories"
  style="--xh-page-bg: {{ section.settings.page_background | default: '#f3f3f3' }}; --xh-text: {{ section.settings.text_color | default: '#111111' }}; --xh-muted: {{ section.settings.muted_text_color | default: '#6c6c6c' }}; --xh-category-title: {{ section.settings.card_text_color | default: '#ffffff' }};"
>
  <div class="xh-container">
    <div class="xh-section-header">
      <div>
        {% if section.settings.categories_kicker != blank %}
          <p class="xh-eyebrow">{{ section.settings.categories_kicker | escape }}</p>
        {% endif %}
        {% if section.settings.categories_title != blank %}
          <h2 class="xh-heading">{{ section.settings.categories_title | escape }}</h2>
        {% endif %}
      </div>
    </div>

    <div class="xh-card-grid">
      {% for block in section.blocks %}
        {% liquid
          assign category_asset = block.settings.asset_image

          if category_asset == blank
            case block.id
              when 'category_mini'
                assign category_asset = 'xstrape-category-best-sellers.jpg'
              when 'category_camping'
                assign category_asset = 'xstrape-category-power.jpg'
              when 'category_protection'
                assign category_asset = 'xstrape-category-accessories.jpg'
              when 'category_home'
                assign category_asset = 'xstrape-category-bands.jpg'
            endcase
          endif
        %}

        <a class="xh-media-card xh-category-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          <span class="xh-media-card__image">
            {% if category_asset != blank %}
              <img
                src="{{ category_asset | asset_url }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="1000"
                height="245"
              >
            {% elsif block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 50vw, 25vw', widths: '200,400,600,800,1000,1200'
              }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'xh-media-card__placeholder' }}
            {% endif %}
          </span>
          <span class="xh-media-card__body">
            {% if block.settings.title != blank %}
              <h3 class="xh-media-card__title"><span>{{ block.settings.title | escape }}</span></h3>
            {% endif %}
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Xstrape categories",
  "class": "shopify-section--xstrape-categories",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "categories_kicker", "label": "Kicker" },
    { "type": "text", "id": "categories_title", "label": "Heading", "default": "Shop by Category" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "page_background", "label": "Background", "default": "#f3f3f3" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text", "default": "#6c6c6c" },
    { "type": "color", "id": "card_text_color", "label": "Card text", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category card",
      "settings": [
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "text", "id": "title", "label": "Title", "default": "Category" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "asset_image", "label": "Theme asset image filename" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Xstrape categories" }
  ]
}
{% endschema %}
